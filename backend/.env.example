# ============================================
# 大力馒头 · 环境变量配置
# 复制此文件为 .env 后填入真实值
# .env 已加入 .gitignore，不会被提交到 GitHub
# ============================================

# ---- 管理员认证（必填）----
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_here_change_this

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=bakery

# ---- 微信小程序 ----
WX_APP_ID=wx_your_appid
WX_APP_SECRET=your_app_secret

# ---- 微信支付（云托管封装方案，免证书/免签名/免公网回调）----
# 前置：云托管控制台 → 设置 → 其他设置 → 微信支付配置 → 绑定商户号
# 详细：https://developers.weixin.qq.com/minigame/dev/wxcloudrun/src/guide/weixin/pay.html
WX_PAY_SUB_MCHID=1115646657
