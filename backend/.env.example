# ============================================
# 大力馒头 · 环境变量配置
# 复制此文件为 .env 后填入真实值
# .env 已加入 .gitignore，不会被提交到 GitHub
# ============================================

# ---- 管理员认证（必填）----
ADMIN_PASSWORD=your_admin_password_here
JWT_SECRET=your_jwt_secret_here_change_this

# ---- MySQL 数据库 ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=bakery

# ---- 微信支付 API v3（开通商户号后填写）----
# WX_APPID=wx_your_appid
# WX_APP_SECRET=your_app_secret
# WX_PAY_MCHID=your_merchant_id
# WX_PAY_SERIAL_NO=your_cert_serial
# WX_PAY_PRIVATE_KEY=your_private_key_pem
# WX_PAY_API_V3_KEY=your_api_v3_key_32chars
# WX_PAY_NOTIFY_URL=https://your-domain.com/api/pay/notify
