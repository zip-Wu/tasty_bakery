/* 通知授权页 - 全屏居中布局 */
page {
  background: #f5f5f5;
}

.notify-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ====== 主区域 ====== */
.notify-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.notify-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
}

.notify-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 12rpx;
}

.notify-sub {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-bottom: 48rpx;
}

.notify-auth-btn {
  width: 580rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: #0ab98e;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(10,185,142,0.3);
}

.notify-skip {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #bbb;
}

/* ====== 手机号区域 ====== */
.notify-phone-section {
  width: 600rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 40rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.04);
}

.phone-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
  text-align: center;
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.phone-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #0ab98e;
}

.phone-edit {
  font-size: 24rpx;
  color: #333;
  background: #f0f0f0;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.phone-clear {
  font-size: 24rpx;
  color: #e53935;
  background: #fff0f0;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
}

.phone-input-row {
  display: flex;
  gap: 16rpx;
}

.phone-input {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.phone-save-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #333;
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: none;
  padding: 0;
}

/* ====== 底部 ====== */
.notify-footer {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 26rpx;
  color: #bbb;
}
