<view class="container tab-bar-page">
  <!-- 顶部门店栏 -->
  <view class="store-bar">
    <view class="store-info">
      <text class="store-name" bindtap="navigateToStore" hover-class="text-press">{{store.name}} ></text>
      <view class="distance-row">
        <text class="store-distance">{{store.distance}}</text>
        <view class="locate-btn" wx:if="{{store.distance === '未知距离'}}" catchtap="tryCalcDistance">获取距离</view>
      </view>
    </view>
    <view class="store-closed-tag" wx:if="{{storeClosed}}">已打烊</view>
  </view>

  <!-- 主内容区：左分类 + 右商品 -->
  <view class="main-content">
    <!-- 左侧分类 -->
    <scroll-view class="category-list" scroll-y="{{true}}">
      <view
        class="category-item {{currentCategory === item ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:for-index="idx"
        wx:key="*this"
        bindtap="switchCategory"
        data-category="{{item}}"
      >
        <block wx:for="{{categoryLines[idx]}}" wx:key="*this" wx:for-item="line">
          <view class="category-line">{{line}}</view>
        </block>
      </view>
    </scroll-view>

    <!-- 右侧商品 -->
    <scroll-view class="goods-list" scroll-y="{{true}}" scroll-top="{{scrollTop}}" scroll-with-animation="{{true}}">
      <!-- 商品列表 -->
      <block wx:for="{{filteredBreadList}}" wx:key="id">
        <view class="goods-item {{item.stock <= 0 ? 'out-of-stock' : ''}} {{!item._show ? 'goods-hidden' : ''}}">
          <!-- 售罄灰色遮罩（覆盖整张卡片，pointer-events: none 透传点击到详情页） -->
          <view class="stock-overlay" wx:if="{{item.stock <= 0}}"></view>
          <!-- 图片单独一格：可点进详情；新品角标定位在图片左上角 -->
          <view class="goods-img-wrap">
            <image class="goods-img" src="{{item.image}}" mode="aspectFill"
              bindtap="navigateToProductDetail" data-id="{{item.id}}"></image>
            <view class="new-tag" wx:if="{{item.is_new}}">新品</view>
          </view>
          <!-- 右侧区域：上方名称简介（可点详情），下方销售/温度/价格/操作（不可点） -->
          <view class="goods-right">
            <view class="goods-click-area" bindtap="navigateToProductDetail" data-id="{{item.id}}">
              <text class="goods-name">{{item.name}}</text>
              <text class="goods-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <!-- 底部组：库存 + 月销 + 价格/操作 -->
            <view class="goods-info">
              <view class="goods-bottom">
                <view class="goods-bottom-left">
                  <text class="goods-price">¥{{item.price}}</text>
                  <text class="goods-stock">库存: {{item.stock || 0}}</text>
                  <text class="goods-sales" wx:if="{{!cart[item.id]}}">月销: {{item.monthlySales || 0}}</text>
                </view>
                <view class="goods-action">
                  <!-- 减号/数量不依赖 stock>0：售罄商品已在购物车时仍可减掉删除（遮罩 pointer-events:none 不挡点击） -->
                  <view class="count-btn minus" wx:if="{{!storeClosed && cart[item.id] > 0}}" catchtap="minusFromCart" data-id="{{item.id}}"><text>−</text></view>
                  <text class="goods-count" wx:if="{{!storeClosed && cart[item.id] > 0}}">{{cart[item.id]}}</text>
                  <view class="count-btn plus" wx:if="{{!storeClosed && item.stock > 0 && (cart[item.id] || 0) < item.stock}}" catchtap="addToCart" data-id="{{item.id}}"><text>+</text></view>
                  <view class="count-btn plus disabled" wx:elif="{{!storeClosed && item.stock > 0}}"><text>+</text></view>
                  <text class="sold-out-tag" wx:if="{{item.stock <= 0}}">售罄</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 空状态 -->
      <view class="empty-goods" wx:if="{{filteredBreadList.length === 0}}">
        <image class="empty-icon" src="/images/svg/bread.svg" mode="aspectFit"></image>
        <text class="empty-text">暂无商品</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar {{storeClosed ? 'closed' : ''}}">
    <block wx:if="{{storeClosed}}">
      <view class="cart-info">
        <view class="cart-icon">
          <image class="cart-icon-img" src="/images/svg/cart.svg" mode="aspectFit"></image>
        </view>
        <text class="cart-count-text">店家已打烊</text>
      </view>
      <view class="checkout-btn disabled">暂不可下单</view>
    </block>
    <block wx:else>
    <view class="cart-info">
      <view class="cart-icon">
        <image class="cart-icon-img" src="/images/svg/cart.svg" mode="aspectFit"></image>
        <view class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
      <view class="cart-price-wrap">
        <text class="cart-total">¥{{cartTotal}}</text>
        <text class="cart-count-text">已选 {{cartCount}} 件</text>
      </view>
    </view>
    <view class="checkout-btn {{cartCount > 0 ? 'active' : ''}}" bindtap="goToCheckout">去结算</view>
    </block>
  </view>

  <!-- 自定义悬浮TabBar -->
  <custom-tab-bar></custom-tab-bar>
</view>