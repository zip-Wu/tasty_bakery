page {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  background: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶部门店栏 */
.store-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
  z-index: 100;
}

.store-info {
  display: flex;
  flex-direction: column;
}

.store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
}
.text-press {
  opacity: 0.6;
}

.store-distance {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.distance-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.locate-btn {
  font-size: 22rpx;
  color: #8B6914;
  background: #FFFDEB;
  border: 2rpx solid #F3D624;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}

/* 主内容区 */
.main-content {
  position: fixed;
  top: 120rpx;
  bottom: 300rpx; /* 购物车(100) + 间距 + tabBar(110) + 底部间距 */
  left: 0;
  right: 0;
  display: flex;
  overflow: hidden;
  background: #fff;
}

/* 左侧分类 */
.category-list {
  width: 180rpx;
  height: 100%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.category-item {
  padding: 28rpx 20rpx;
  text-align: center;
  border-left: 6rpx solid transparent;
}

.category-item.active {
  background: #fff;
  border-left-color: #F3D624;
}

.category-name {
  font-size: 26rpx;
  color: #666;
}

.category-item.active .category-name {
  color: #333;
  font-weight: bold;
}

/* 右侧商品 */
.goods-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  background: #fff;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.goods-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

/* 右侧区域：上方名称简介（可点详情），下方销售/温度/价格/操作（不可点） */
.goods-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  /* 默认 stretch 到 180rpx（与图片同高） */
}
.goods-click-area {
  /* 名称 + 简介，可点进详情页 */
}

.goods-info {
  display: flex;
  flex-direction: column;
  margin-top: auto;  /* 温度 + 价格/操作推到底 */
}

.goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}

.goods-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.4;
  margin-top: 4rpx;
  /* 最多 2 行，超出显示 ... */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.goods-sales {
  font-size: 18rpx;
  color: #aaa;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.goods-bottom-left {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  min-width: 0;
  flex-shrink: 1;
}

.goods-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #e53935;
}

.goods-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.count-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.count-btn.minus {
  background: #f5f5f5;
  color: #666;
}

.count-btn.plus {
  background: #F3D624;
  color: #333;
}

.goods-count {
  font-size: 26rpx;
  color: #333;
  min-width: 32rpx;
  text-align: center;
}

.temp-tag {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}
.temp-tag-inner {
  display: inline-flex;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e0e0e0;
}
.temp-option {
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  color: #999;
  background: #f5f5f5;
}
.temp-option.temp-cold.active {
  color: #fff;
  background: #4fc3f7;
  font-weight: bold;
}
.temp-option.temp-hot.active {
  color: #fff;
  background: #ff8a65;
  font-weight: bold;
}

/* 空状态 */
.empty-goods {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部购物车栏 - 悬浮胶囊样式 */
.cart-bar {
  position: fixed;
  bottom: 170rpx; /* 悬浮在tabBar上方：24rpx(间距) + 110rpx(tabBar) + 20rpx(间距) */
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  z-index: 998;
  height: auto;
  min-height: 100rpx;
}

.cart-info {
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.cart-icon-text {
  font-size: 40rpx;
}

.cart-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #e53935;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.cart-price-wrap {
  display: flex;
  flex-direction: column;
}

.cart-total {
  font-size: 36rpx;
  font-weight: bold;
  color: #e53935;
}

.cart-count-text {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.checkout-btn {
  background: #ccc;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 20rpx 48rpx;
}

.checkout-btn.active {
  background: #F3D624;
}
