page {
  width: 100vw;
  height: 100vh;
  margin: 0;
  padding: 0;
  background: #f5f5f5;
}

.container {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶部门店栏 */
.store-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
  z-index: 100;
}

.store-info {
  display: flex;
  flex-direction: column;
}

.store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #222;
}
.text-press {
  opacity: 0.6;
}

.store-distance {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

.distance-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 4rpx;
}

.locate-btn {
  font-size: 22rpx;
  color: #8B6914;
  background: #FFFDEB;
  border: 2rpx solid #F3D624;
  border-radius: 16rpx;
  padding: 4rpx 16rpx;
}

/* 主内容区 */
.main-content {
  position: fixed;
  top: 120rpx;
  bottom: 300rpx; /* 购物车(100) + 间距 + tabBar(110) + 底部间距 */
  left: 0;
  right: 0;
  display: flex;
  overflow: hidden;
  background: #fff;
}

/* 左侧分类 */
.category-list {
  width: 180rpx;
  height: 100%;
  background: #f5f5f5;
  flex-shrink: 0;
}

.category-item {
  padding: 14rpx 12rpx;
  text-align: center;
  border-left: 6rpx solid transparent;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 120rpx;
  box-sizing: border-box;
}

.category-item.active {
  background: #fff;
  border-left-color: #F3D624;
}

.category-line {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
  white-space: nowrap;  /* 防「🆕」等 emoji 宽度导致意外换行 */
}

.category-item.active .category-line {
  color: #333;
  font-weight: bold;
}

/* 右侧商品 */
.goods-list {
  flex: 1;
  height: 100%;
  background: #fff;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  background: #fff;
}

.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.goods-img-wrap {
  position: relative;  /* 新品角标的定位容器（image 为自闭合组件，不能包角标） */
  flex-shrink: 0;
}

.goods-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background: #f5f5f5;
  flex-shrink: 0;
}

/* 新品角标（v1 + 轻阴影）：左上角，z-index:2 高于售罄遮罩(1) → 售罄时仍可见；
   轻阴影与 cart-bar 阴影同语言但力度收敛一档 */
.new-tag {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  font-size: 20rpx;
  font-weight: bold;
  color: #fff;
  background: #e53935;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  z-index: 2;
  line-height: 1.2;
  box-shadow: 0 4rpx 10rpx rgba(229, 57, 53, 0.3);
  pointer-events: none;
}

/* 右侧区域：上方名称简介（可点详情），下方销售/温度/价格/操作（不可点） */
.goods-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  /* 默认 stretch 到 180rpx（与图片同高） */
}
.goods-click-area {
  /* 名称 + 简介，可点进详情页 */
}

.goods-info {
  display: flex;
  flex-direction: column;
  margin-top: auto;  /* 温度 + 价格/操作推到底 */
}

.goods-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #222;
}

.goods-desc {
  font-size: 20rpx;
  color: #999;
  line-height: 1.4;
  margin-top: 4rpx;
  /* 最多 2 行，超出显示 ... */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
.goods-sales {
  font-size: 16rpx;  /* 比库存稍小一档：月销是次要信息，不该抢眼 */
  color: #aaa;
  line-height: 1;  /* 显式锁定行高，消除默认行高带来的基线偏移 */
  flex-shrink: 0;
}

.goods-stock {
  font-size: 18rpx;
  color: #aaa;
  line-height: 1;  /* 与 .goods-sales 同款行高，保证两段文字基线完全对齐 */
  flex-shrink: 0;
}

.goods-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.goods-bottom-left {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
  flex-shrink: 1;
  /* 三元素横向排列，baseline 对齐保证库存/月销同一水平线；
     月销在加购后自动隐藏（wx:if），不会挤到加减按钮 */
}

.goods-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #e53935;
}

.goods-action {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.count-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.count-btn.minus {
  background: #f5f5f5;
  color: #666;
}

.count-btn.plus {
  background: #F3D624;
  color: #333;
}

/* 数量达到库存上限时的灰态加号（不可再点） */
.count-btn.plus.disabled {
  background: #e0e0e0;
  color: #aaa;
}

.goods-count {
  font-size: 26rpx;
  color: #333;
  min-width: 32rpx;
  text-align: center;
}

.temp-tag {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 4rpx;
  flex-shrink: 0;
}
.temp-tag-inner {
  display: inline-flex;
  border-radius: 20rpx;
  overflow: hidden;
  border: 2rpx solid #e0e0e0;
}
.temp-option {
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  color: #999;
  background: #f5f5f5;
}
.temp-option.temp-cold.active {
  color: #fff;
  background: #4fc3f7;
  font-weight: bold;
}
.temp-option.temp-hot.active {
  color: #fff;
  background: #ff8a65;
  font-weight: bold;
}

/* 空状态 */
.empty-goods {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 底部购物车栏 - 悬浮胶囊样式 */
.cart-bar {
  position: fixed;
  bottom: 170rpx; /* 悬浮在tabBar上方：24rpx(间距) + 110rpx(tabBar) + 20rpx(间距) */
  left: 24rpx;
  right: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx;
  background: #fff;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
  z-index: 998;
  height: auto;
  min-height: 100rpx;
}

.cart-info {
  display: flex;
  align-items: center;
}

.cart-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  background: #333;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.cart-icon-text {
  font-size: 40rpx;
}

.cart-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  background: #e53935;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  min-width: 32rpx;
  text-align: center;
}

.cart-price-wrap {
  display: flex;
  flex-direction: column;
}

.cart-total {
  font-size: 36rpx;
  font-weight: bold;
  color: #e53935;
}

.cart-count-text {
  font-size: 22rpx;
  color: #888;
  margin-top: 4rpx;
}

.checkout-btn {
  background: #ccc;
  color: #333;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 50rpx;
  padding: 20rpx 48rpx;
}

.checkout-btn.active {
  background: #F3D624;
}
.checkout-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

/* ========== 预定状态标签（store-bar 右上角，配色与门店导航页一致） ========== */
.store-status-tag {
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  transition: opacity 0.15s;
}

.store-status-tag.open {
  background: #e8f5e9;
  color: #4caf50;
}

.store-status-tag.closed {
  background: #fdecea;
  color: #e53935;
}

/* ========== 售罄状态 ========== */
.goods-item.out-of-stock {
  position: relative;
}
.stock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(180, 180, 180, 0.35);
  border-radius: 12rpx;
  z-index: 1;
  pointer-events: none;  /* 透传点击到下方详情页链接 */
}
.sold-out-tag {
  font-size: 20rpx;
  color: #999;
  padding: 4rpx 12rpx;
  background: #eee;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* ========== 预定状态说明弹窗 ========== */
/* 点按反馈与门店名一致；胶囊外侧的箭头只作「可展开」提示 */
.tag-press {
  opacity: 0.6;
}
.store-status {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}
.status-arrow {
  font-size: 28rpx;
  color: #c9c9c9;
  line-height: 1;
  transform: translateY(-2rpx);
}

.status-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;  /* 高于自定义 tabBar(999)，否则弹窗打开时 tabBar 会浮在遮罩上 */
  /* 底部有自定义 tabBar 与结算栏，几何中心会显得偏下；用下内边距把弹窗整体上抬 */
  padding-bottom: 180rpx;
  animation: mask-fade 0.2s ease-out;
}
.status-modal-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.45);
}
.status-modal-card {
  position: relative;
  width: 78%;
  padding: 44rpx 36rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.16);
  animation: card-pop 0.24s cubic-bezier(0.2, 0.9, 0.3, 1.15);
}
.status-modal-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 36rpx;
  color: #c4c4c4;
}
.status-modal-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.status-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.status-icon.open {
  background: #e8f5e9;
}
.status-icon.closed {
  background: #fdecea;
}
/* 对勾用两条边框旋转而成，避免引入自带固定配色的图标文件 */
.status-icon-mark {
  width: 26rpx;
  height: 13rpx;
  border-left: 5rpx solid #4caf50;
  border-bottom: 5rpx solid #4caf50;
  border-radius: 2rpx;
  transform: rotate(-45deg) translate(2rpx, -3rpx);
}
.status-icon-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #e53935;
  line-height: 1;
}
.status-modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #222;
}
.status-modal-desc {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
  text-align: center;
}
/* 信息区用浅灰底卡片包起来，和白色卡面分层，避免整块留白显得干 */
.status-modal-info {
  margin-top: 28rpx;
  padding: 4rpx 24rpx;
  background: #f7f8f7;
  border-radius: 16rpx;
}
.status-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ececec;
}
.status-info-row:last-child {
  border-bottom: none;
}
.status-info-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}
.status-info-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #222;
  text-align: right;
  margin-left: 24rpx;
}
.status-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.status-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}
/* 克制版：浅绿底 + 绿字，和开放态图标底色同系，不与黄色主按钮抢视觉 */
.status-btn.call {
  background: #e8f5e9;
  color: #3d9b46;
  border: 1rpx solid #c5e6cb;
  line-height: 78rpx;
}
.status-btn.primary {
  background: #F3D624;
  color: #222;
  font-weight: bold;
}
@keyframes mask-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes card-pop {
  from { opacity: 0; transform: scale(0.88) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* 分类切换时隐藏不匹配的商品（display:none 保持 DOM 不销毁，图片不重载） */
.goods-hidden {
  display: none;
}
