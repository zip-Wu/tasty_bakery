page {
  background: #f5f5f5;
}

.order-confirm {
  padding-bottom: 120rpx;
}

/* ========== 门店信息 ========== */
.store-info {
  background: linear-gradient(135deg, #f5a623 0%, #e6951c 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.store-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.store-addr {
  font-size: 26rpx;
  opacity: 0.9;
}

/* ========== 订单商品 ========== */
.order-items {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.order-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-item:last-child {
  border-bottom: none;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.item-price {
  font-size: 26rpx;
  color: #f5a623;
  font-weight: bold;
}

.item-qty {
  font-size: 28rpx;
  color: #999;
}

/* ========== 取餐时间 ========== */
.pickup-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.pickup-time .label {
  font-size: 28rpx;
  color: #333;
}

.time-value {
  display: flex;
  align-items: center;
  color: #f5a623;
  font-size: 28rpx;
}

.time-value .arrow {
  margin-left: 8rpx;
  font-size: 32rpx;
}

/* ========== 订单金额 ========== */
.order-summary {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
}

.summary-row.total {
  border-top: 1rpx solid #eee;
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-weight: bold;
  color: #333;
}

.total-price {
  color: #f5a623;
  font-size: 36rpx;
}

/* ========== 支付方式 ========== */
.pay-section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.pay-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.pay-method {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.pay-method.selected {
  border-color: #f5a623;
  background: #fffbf5;
}

.method-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.check {
  color: #f5a623;
  font-size: 32rpx;
  font-weight: bold;
}

/* ========== 底部支付栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.total-info {
  flex: 1;
}

.total-label {
  font-size: 26rpx;
  color: #999;
}

.total-amount {
  font-size: 44rpx;
  font-weight: bold;
  color: #f5a623;
  margin-left: 8rpx;
}

.pay-btn {
  background: linear-gradient(135deg, #f5a623 0%, #e6951c 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
}

.pay-btn.disabled {
  opacity: 0.6;
}