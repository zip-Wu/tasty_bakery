page {
  background: #f5f5f5;
}

.order-confirm {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ========== 门店信息 ========== */
.store-info {
  background: #F3D624;
  padding: 40rpx 30rpx;
  color: #333;
}

.store-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.store-addr {
  font-size: 26rpx;
  opacity: 0.9;
}

/* ========== 订单商品 ========== */
.order-items {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.order-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
  display: flex;
  flex-direction: column;
}

.order-item-row {
  display: flex;
  align-items: center;
}

.order-item:last-child {
  border-bottom: none;
}

.item-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
}

.item-info {
  flex: 1;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.item-temp {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 8rpx;
}
.temp-cold { color: #1976d2; background: #e3f2fd; }
.temp-hot  { color: #bf360c; background: #fff3e0; }

.item-price {
  font-size: 26rpx;
  color: #e53935;
  font-weight: bold;
}

.item-qty {
  font-size: 28rpx;
  color: #999;
}

/* 温度分派 */
.temp-alloc {
  margin-top: 12rpx;
  margin-left: 120rpx;
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}
.temp-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.temp-alloc {
  margin-top: 12rpx;
  margin-left: 120rpx;
  display: flex;
  flex-direction: row;
  gap: 28rpx;
}
.temp-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.temp-label {
  font-size: 22rpx;
  font-weight: bold;
}
.temp-cold-lbl { color: #1976d2; }
.temp-hot-lbl  { color: #d84315; }
.temp-qty-ctrl {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.tqc-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: bold;
  background: #f0f0f0;
  color: #666;
}
.tqc-btn.disabled { opacity: 0.35; }
.tqc-num {
  font-size: 26rpx;
  font-weight: bold;
  width: 56rpx;
  text-align: center;
  color: #333;
  height: 44rpx;
  line-height: 44rpx;
  border: 1px solid #e0e0e0;
  border-radius: 8rpx;
  background: #fff;
  padding: 0;
  box-sizing: border-box;
}

/* 备注卡片 */
.remark-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.remark-header {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.remark-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 26rpx;
  color: #333;
  line-height: 1.5;
  background: #f9f9f9;
  border: 2rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

/* ========== 订单金额 ========== */
.order-summary {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  padding: 12rpx 0;
}

.summary-row.total {
  border-top: 1rpx solid #eee;
  margin-top: 12rpx;
  padding-top: 20rpx;
  font-weight: bold;
  color: #333;
}

.total-price {
  color: #e53935;
  font-size: 36rpx;
}

/* ========== 支付方式 ========== */
.pay-section {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.pay-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.pay-method {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.pay-method.selected {
  border-color: #F3D624;
  background: #fffbf5;
}

.method-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

.method-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
}

/* ========== 底部支付栏 ========== */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: content-box;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  z-index: 100;
}

.total-info {
  flex: 1;
}

.total-label {
  font-size: 26rpx;
  color: #999;
}

.total-amount {
  font-size: 44rpx;
  font-weight: bold;
  color: #e53935;
  margin-left: 8rpx;
}

.pay-btn {
  background: #F3D624;
  color: #333;
  font-size: 32rpx;
  font-weight: bold;
  padding: 24rpx 60rpx;
  border-radius: 50rpx;
}

.pay-btn.disabled {
  opacity: 0.6;
}