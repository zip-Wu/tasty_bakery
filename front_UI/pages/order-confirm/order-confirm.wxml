<!-- 订单确认页 -->
<view class="order-confirm">
  <!-- 门店信息 -->
  <view class="store-info">
    <view class="store-name">{{order.storeName || '信息港店'}}</view>
    <view class="store-addr">{{order.address || '珠海市高新区唐家湾镇香山路88号2栋1层101-10室'}}</view>
  </view>

  <!-- 订单商品 -->
  <view class="order-items">
    <view class="order-item" wx:for="{{order.items}}" wx:key="id">
      <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-price">¥{{item.price}}</text>
      </view>
      <view class="item-qty">x{{item.quantity}}</view>
    </view>
  </view>

  <!-- 订单金额 -->
  <view class="order-summary">
    <view class="summary-row">
      <text>商品金额</text>
      <text>¥{{order.totalPrice}}</text>
    </view>
    <view class="summary-row total">
      <text>合计</text>
      <text class="total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="pay-section">
    <view class="pay-title">支付方式</view>
    <view class="pay-method selected">
      <text class="method-icon">💳</text>
      <text class="method-name">微信支付</text>
      <text class="check">✓</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">实付</text>
      <text class="total-amount">¥{{order.totalPrice}}</text>
    </view>
    <view class="pay-btn {{isPaying ? 'disabled' : ''}}" bindtap="doPay">
      {{isPaying ? '支付中...' : '确认支付'}}
    </view>
  </view>
</view>