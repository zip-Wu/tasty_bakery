<!-- 订单确认页 -->
<view class="order-confirm">
  <!-- 门店信息 -->
  <view class="store-info">
    <view class="store-name">{{order.storeName || '信息港店'}}</view>
    <view class="store-addr">{{order.address || '珠海市高新区唐家湾镇香山路88号2栋1层101-10室'}}</view>
  </view>

  <!-- 订单商品 -->
  <view class="order-items">
    <view class="order-item" wx:for="{{order.items}}" wx:key="id" wx:for-index="idx">
      <view class="order-item-row">
        <image class="item-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="item-info">
          <text class="item-name">{{item.name}}</text>
          <text class="item-price">¥{{item.price}}</text>
        </view>
        <text class="item-qty">x{{item.quantity}}</text>
      </view>
      <!-- 温度分派 -->
      <view class="temp-alloc">
        <view class="temp-row">
          <text class="temp-label temp-cold-lbl">常温</text>
          <text class="tqc-num">{{item.coldQty || 0}}</text>
        </view>
        <view class="temp-row">
          <text class="temp-label temp-hot-lbl">加热</text>
          <view class="temp-qty-ctrl">
            <view class="tqc-btn {{item.hotQty > 0 ? '' : 'disabled'}}" data-idx="{{idx}}" data-temp="hot" data-delta="-1" bindtap="changeTemp">−</view>
            <input class="tqc-num" type="number" value="{{item.hotQty}}" bindinput="onHotQtyInput" data-idx="{{idx}}" />
            <view class="tqc-btn {{item.hotQty < item.quantity ? '' : 'disabled'}}" data-idx="{{idx}}" data-temp="hot" data-delta="1" bindtap="changeTemp">+</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 备注 -->
  <view class="remark-card">
    <view class="remark-header">备注</view>
    <textarea class="remark-textarea" placeholder="可在此输入特殊需求..." value="{{remark}}" bindinput="onRemarkInput" bindblur="saveRemark" maxlength="50" auto-height />
  </view>

  <!-- 订单金额 -->
  <view class="order-summary">
    <view class="summary-row">
      <text>商品金额</text>
      <text>¥{{order.totalPrice}}</text>
    </view>
    <view class="summary-row total">
      <text>合计</text>
      <text class="total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 支付方式 -->
  <view class="pay-section">
    <view class="pay-title">支付方式</view>
    <view class="pay-method selected">
      <image class="method-icon" src="/images/svg/credit-card.svg" mode="aspectFit"></image>
      <text class="method-name">微信支付</text>
      <image class="check-icon" src="/images/svg/check.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="bottom-bar">
    <view class="total-info">
      <text class="total-label">实付</text>
      <text class="total-amount">¥{{order.totalPrice}}</text>
    </view>
    <view class="pay-btn {{isPaying ? 'disabled' : ''}}" bindtap="doPay">
      {{isPaying ? '支付中...' : '确认支付'}}
    </view>
  </view>
</view>