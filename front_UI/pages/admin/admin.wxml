<!-- 商家管理页面 -->

<!-- ====== 未登录：密码输入 ====== -->
<view class="login-page" wx:if="{{!loggedIn}}">
  <view class="login-card">
    <text class="login-title">🔐 商家管理</text>
    <text class="login-sub">请输入管理密码</text>
    <input class="login-input" type="password" placeholder="请输入密码"
      value="{{password}}" bindinput="onPasswordInput" />
    <text class="login-error" wx:if="{{loginError}}">{{loginError}}</text>
    <button class="login-btn" bindtap="doLogin">登录</button>
  </view>
</view>

<!-- ====== 已登录：管理面板 ====== -->
<view class="admin-page" wx:if="{{loggedIn}}">
  <!-- 顶部 Tab 栏 -->
  <view class="tab-bar">
    <view class="tab-item {{currentTab === 'orders' ? 'active' : ''}}"
      bindtap="switchTab" data-tab="orders">订单管理</view>
    <view class="tab-item {{currentTab === 'production' ? 'active' : ''}}"
      bindtap="switchTab" data-tab="production">制作清单</view>
    <view class="tab-item {{currentTab === 'products' ? 'active' : ''}}"
      bindtap="switchTab" data-tab="products">商品管理</view>
    <view class="tab-item {{currentTab === 'quick-sale' ? 'active' : ''}}"
      bindtap="switchTab" data-tab="quick-sale">快速录单</view>
    <view class="tab-item {{currentTab === 'dashboard' ? 'active' : ''}}"
      bindtap="switchTab" data-tab="dashboard">营收看板</view>
    <view class="tab-item logout-tab" bindtap="doLogout">退出</view>
  </view>

  <!-- 门店开关状态栏 -->
  <view class="store-toggle-bar {{storeOpen ? 'open' : 'closed'}}" bindtap="toggleStore">
    <view class="store-toggle-left">
      <text class="store-toggle-dot {{storeOpen ? 'on' : 'off'}}"></text>
      <view class="store-toggle-text">
        <text class="store-toggle-label">{{storeOpen ? '接受预定中' : '暂无法预定'}}</text>
        <text class="store-toggle-hint">{{storeOpen ? '顾客可正常下单预定' : '顾客暂时无法下单'}}</text>
      </view>
    </view>
    <view class="store-toggle-btn">{{storeOpen ? '停止接单' : '开始接单'}}</view>
  </view>

  <swiper class="admin-swiper" current="{{tabIndex}}" bindchange="onTabSwipe" duration="250">
  <swiper-item>
  <!-- ====== 订单管理 ====== -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{true}}">
    <!-- 状态筛选 -->
    <scroll-view scroll-x class="filter-scroll">
      <view class="filter-item {{orderFilter === item.key ? 'active' : ''}}"
        wx:for="{{orderFilters}}" wx:key="key"
        bindtap="filterOrders" data-filter="{{item.key}}">
        {{item.label}}
        <text class="filter-badge" wx:if="{{orderCounts[item.key] > 0}}">{{orderCounts[item.key]}}</text>
      </view>
    </scroll-view>

    <!-- 新订单提醒横幅 -->
    <view class="new-order-banner" wx:if="{{newOrderAlert}}" bindtap="dismissNewAlert">
      <text class="banner-text">🔔 有 {{newOrderCount}} 笔新订单，已自动刷新</text>
      <text class="banner-close">✕</text>
    </view>

    <!-- 轮询状态栏 -->
    <view class="poll-bar">
      <view class="poll-indicator {{isPolling ? 'active' : ''}}"></view>
      <text class="poll-text">{{isPolling ? '自动刷新中 · 上次 ' + lastPollTime : '轮询已停止'}}</text>
      <view class="poll-refresh" bindtap="manualRefresh">⟳ 手动刷新</view>
    </view>

    <!-- 订单列表 -->
    <view class="order-list">
      <view class="order-card" wx:for="{{orders}}" wx:key="id">
        <view class="order-header">
          <view class="order-header-left">
            <text class="order-no">{{item.orderNo}}</text>
            <text class="order-date-tag tag-{{item.dateLabel === '今日' ? 'today' : item.dateLabel === '昨日' ? 'yest' : item.dateLabel === '前天' ? 'db' : 'old'}}" wx:if="{{item.dateLabel}}">{{item.dateLabel}}</text>
            <text class="order-source-tag" wx:if="{{item.source === 'offline'}}">线下</text>
          </view>
          <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="order-body">
          <view class="order-items-row" wx:for="{{item.items}}" wx:key="itemKey" wx:for-item="oi">
            <text class="order-item-name">{{oi.name}} x{{oi.quantity}}</text>
          </view>
          <view class="order-bottom">
            <view class="order-bottom-left">
              <view class="order-info">{{item.userNickname || '顾客'}} · {{item.totalQuantity}}件 · ¥{{item.totalPrice}}</view>
              <view class="order-phone" wx:if="{{item.userPhone}}">📱 {{item.userPhone}}</view>
              <view class="order-remark" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
              <view class="order-remark refund-reason" wx:if="{{item.status === 'refund_pending' && item.refundReason}}">
                📝 退款理由：{{item.refundReason}}
              </view>
              <view class="order-remark refund-source" wx:if="{{item.status === 'refund_pending' && item.refundOriginalStatus}}">
                <view class="refund-source-tag {{item.refundOriginalStatus === 'preparing' ? 'source-preparing' : 'source-completed'}}">
                  {{item.refundOriginalStatus === 'preparing' ? '制作中' : '已完成'}}
                </view>
              </view>
              <view class="order-time">{{item.timeDisplay}}</view>
              <view class="order-time refund-req-time" wx:if="{{item.status === 'refund_pending' && item.refundReqDisplay}}">
                申请时间：{{item.refundReqDisplay}}
              </view>
            </view>
            <view class="order-pickup" wx:if="{{item.status === 'ready' || item.status === 'preparing'}}">取餐码：{{item.pickupCode}}</view>
            <button class="action-btn refund-direct-btn order-bottom-refund" wx:if="{{item.status === 'completed' && item.source !== 'offline'}}" size="mini"
              bindtap="directRefund" data-id="{{item.id}}" data-orderno="{{item.orderNo}}">退款</button>
          </view>
        </view>
        <view class="order-actions" wx:if="{{item.status === 'preparing'}}">
          <button class="action-btn ready-btn" size="mini"
            bindtap="markReady" data-id="{{item.id}}">标记待取餐</button>
          <button class="action-btn refund-direct-btn" size="mini"
            bindtap="directRefund" data-id="{{item.id}}" data-orderno="{{item.orderNo}}">退款</button>
        </view>
        <view class="order-actions" wx:if="{{item.status === 'ready'}}">
          <button class="action-btn complete-btn" size="mini"
            bindtap="markComplete" data-id="{{item.id}}">标记已完成</button>
          <button class="action-btn refund-direct-btn" size="mini"
            bindtap="directRefund" data-id="{{item.id}}" data-orderno="{{item.orderNo}}">退款</button>
        </view>
        <view class="order-actions refund-review" wx:if="{{item.status === 'refund_pending'}}">
          <button class="action-btn reject-btn" size="mini"
            bindtap="rejectRefund" data-id="{{item.id}}">拒绝</button>
          <button class="action-btn approve-btn" size="mini"
            bindtap="approveRefund" data-id="{{item.id}}">批准退款</button>
        </view>
      </view>
      <view class="empty" wx:if="{{orders.length === 0}}">
        <text>暂无订单</text>
      </view>

      <!-- 加载更多 -->
      <view class="load-more" wx:if="{{orderHasMore}}" bindtap="loadMoreOrders">
        <text wx:if="{{!orderLoadingMore}}">加载更多订单</text>
        <text wx:else>加载中...</text>
      </view>
    </view>
  </scroll-view>
  </swiper-item>

  <swiper-item>
  <!-- ====== 制作清单 ====== -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{true}}">
    <view class="prod-empty" wx:if="{{productionList.groups.length === 0}}">暂无待制作订单</view>

    <view wx:for="{{productionList.groups}}" wx:key="label" wx:for-item="group">
      <view class="prod-group-header">
        <text class="prod-group-tag tag-{{group.label === '今日' ? 'today' : group.label === '昨日' ? 'yest' : group.label === '前天' ? 'db' : 'old'}}">{{group.label}}</text>
        <text class="prod-group-count">{{group.items.length}} 种 · {{group.customerCount}} 位顾客</text>
      </view>
      <view class="prod-grid" wx:if="{{group.items.length > 0}}">
        <view class="prod-item" wx:for="{{group.items}}" wx:key="id" wx:for-item="pi">
          <text class="prod-name">{{pi.name}}</text>
          <text class="prod-qty">{{pi.total}} 个</text>
        </view>
      </view>
    </view>
  </scroll-view>
  </swiper-item>

  <swiper-item>
  <!-- ====== 商品管理 ====== -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{true}}">
    <view class="section-header">
      <text class="section-title">全部商品（{{products.length}}）</text>
      <view class="header-btns">
        <button class="reset-btn" size="mini" bindtap="resetProducts">清空</button>
        <button class="stock-panel-btn" size="mini" bindtap="openStockPanel">快捷调库存</button>
        <button class="add-btn" size="mini" bindtap="toggleAddForm">+ 新增商品</button>
      </view>
    </view>

    <!-- 新增商品表单 -->
    <view class="add-form" wx:if="{{showAddForm}}">
      <input class="form-input" placeholder="商品名称" value="{{newProduct.name}}" bindinput="onNewName" />
      <input class="form-input" placeholder="价格（数字）" type="digit" value="{{newProduct.price}}" bindinput="onNewPrice" />
      <input class="form-input" placeholder="分类（可选，如：吐司、欧包。留空则不归入任何分类）"
        value="{{newProduct.category}}" bindinput="onNewCategory" />
      <input class="form-input" placeholder="库存量（数字，如：50）" type="number"
        value="{{newProduct.stock}}" bindinput="onNewStock" />
      <textarea class="form-textarea" placeholder="商品简介（可选，点单页简短显示，详情页完整展示）"
        value="{{newProduct.description}}" bindinput="onNewDesc"
        maxlength="500" auto-height="{{true}}" />
      <view class="form-row upload-row">
        <text class="form-label">主图：</text>
        <button class="upload-btn" size="mini" bindtap="chooseImage">
          {{newProduct.image ? '换一张' : '从相册选择'}}
        </button>
      </view>
      <image wx:if="{{newProduct.image}}" class="upload-preview"
        src="{{newProduct.image}}" mode="aspectFill" />
      <!-- 多图上传（gallery） -->
      <view class="form-row" style="margin-bottom: 8rpx;">
        <text class="form-label">图库：</text>
        <button class="upload-btn" size="mini" bindtap="chooseGalleryForNew"
          disabled="{{newProduct.gallery.length >= 9}}">
          添加图片 ({{newProduct.gallery.length}}/9)
        </button>
      </view>
      <scroll-view class="gallery-thumbs" scroll-x="{{true}}" wx:if="{{newProduct.gallery.length > 0}}">
        <view class="gallery-thumb-item" wx:for="{{newProduct.gallery}}" wx:key="*this">
          <image class="gallery-thumb-img" src="{{item}}" mode="aspectFill" />
          <view class="gallery-thumb-del" catchtap="deleteNewGalleryItem" data-idx="{{index}}">✕</view>
        </view>
      </scroll-view>
      <view class="form-btns">
        <button class="form-btn cancel" size="mini" bindtap="toggleAddForm">取消</button>
        <button class="form-btn confirm" size="mini" bindtap="addProduct">新增</button>
      </view>
    </view>

    <!-- 商品列表 -->
    <view class="product-list">
      <view class="product-card {{item.is_available ? '' : 'disabled'}} {{item.is_available && !item.stock ? 'sold-out' : ''}} {{editingId === item.id ? 'editing' : ''}}"
        wx:for="{{products}}" wx:key="id">
        <!-- 正常模式：小图 -->
        <image wx:if="{{editingId !== item.id}}" class="product-img" src="{{item.image}}" mode="aspectFill" />
        <view class="product-info">
          <!-- 正常显示 -->
          <block wx:if="{{editingId !== item.id}}">
            <view class="product-info-top">
            <view class="product-info-text">
                <text class="product-name">{{item.name}}</text>
                <text class="product-cat">{{item.category}}</text>
                <view class="product-stock-row">
                  <text class="product-stock {{item.is_available && !item.stock ? 'sold-out' : ''}}">{{item.is_available && !item.stock ? '已售罄' : '库存'}}</text>
                  <!-- 行内步进器：+/- 直接保存，点数字弹输入框 -->
                  <view class="stock-stepper" wx:if="{{editingStockId !== item.id}}">
                    <view class="stock-btn {{quickStockSaving[item.id] || !item.stock ? 'disabled' : ''}}"
                      catchtap="quickStockChange" data-id="{{item.id}}" data-delta="-1">−</view>
                    <view class="stock-num {{!item.stock ? 'zero' : ''}}"
                      catchtap="startQuickStockEdit" data-id="{{item.id}}">{{item.stock || 0}}</view>
                    <view class="stock-btn plus {{quickStockSaving[item.id] ? 'disabled' : ''}}"
                      catchtap="quickStockChange" data-id="{{item.id}}" data-delta="1">+</view>
                  </view>
                  <!-- 行内库存输入：失焦/回车即存 -->
                  <view class="stock-stepper" wx:else>
                    <input class="stock-input" type="number" value="{{quickStockInput}}" focus="{{true}}"
                      bindinput="onQuickStockInput" bindconfirm="saveQuickStock" bindblur="onQuickStockBlur" />
                    <view class="stock-btn ok" catchtap="saveQuickStock">✓</view>
                    <view class="stock-btn cancel" catchtap="cancelQuickStock">✕</view>
                  </view>
                </view>
              </view>
              <view class="info-right">
                <text class="sold-out-badge" wx:if="{{item.is_available && !item.stock}}">售罄</text>
                <view class="sort-handle">
                  <view class="sort-arrow" catchtap="moveProductUp" data-id="{{item.id}}">▲</view>
                  <view class="sort-arrow" catchtap="moveProductDown" data-id="{{item.id}}">▼</view>
                </view>
              </view>
            </view>
            <view class="product-price-row">
              <text class="product-price">¥{{item.price}}</text>
              <text class="product-sales">售{{item.sales || 0}}</text>
            </view>
          </block>
          <!-- 编辑模式 -->
          <block wx:if="{{editingId === item.id}}">
            <view class="edit-layout">
              <!-- 左侧：大图 -->
              <view class="edit-left">
                <image class="edit-image" src="{{editImage || item.image}}" mode="aspectFill" bindtap="chooseEditImage" />
                <button class="upload-btn" size="mini" bindtap="chooseEditImage">更换图片</button>
              </view>
              <!-- 右侧：表单 -->
              <view class="edit-right">
                <view class="edit-row-flex">
                  <text class="edit-label-left">名称</text>
                  <input class="edit-input-right" placeholder="商品名称" value="{{editName}}" bindinput="onEditName" />
                </view>
                <view class="edit-row-flex">
                  <text class="edit-label-left">价格</text>
                  <input class="edit-input-right" placeholder="价格" type="digit" value="{{editPrice}}" bindinput="onEditPrice" />
                </view>
                <view class="edit-row-flex">
                  <text class="edit-label-left">分类</text>
                  <input class="edit-input-right" placeholder="如：吐司" value="{{editCategory}}" bindinput="onEditCategory" />
                </view>
                <view class="edit-row-flex">
                  <text class="edit-label-left">库存</text>
                  <input class="edit-input-right" placeholder="库存" type="number" value="{{editStock}}" bindinput="onEditStock" />
                </view>
                <view class="edit-row-flex edit-row-desc">
                  <text class="edit-label-left">简介</text>
                  <textarea class="edit-input-right edit-textarea" placeholder="商品简介（可选）"
                    value="{{editDescription}}" bindinput="onEditDesc"
                    maxlength="500" auto-height="{{true}}" />
                </view>
              </view>
            </view>
            <!-- 编辑模式：图库管理 -->
            <view class="edit-gallery-row">
              <text class="edit-gallery-label">商品图库 ({{editGallery.length}}/9)：</text>
              <button class="upload-btn" size="mini" bindtap="chooseGalleryForEdit"
                disabled="{{editGallery.length >= 9}}">添加图片</button>
            </view>
            <scroll-view class="gallery-thumbs" scroll-x="{{true}}" wx:if="{{editGallery.length > 0}}">
              <view class="gallery-thumb-item" wx:for="{{editGallery}}" wx:key="*this">
                <image class="gallery-thumb-img" src="{{item}}" mode="aspectFill" />
                <view class="gallery-thumb-del" catchtap="deleteEditGalleryItem" data-idx="{{index}}">✕</view>
              </view>
            </scroll-view>
            <view class="edit-btns">
              <button class="edit-confirm" size="mini" bindtap="saveEdit">保存</button>
              <button class="edit-cancel-btn" size="mini" bindtap="cancelEdit">取消</button>
            </view>
          </block>
        </view>
        <view class="product-actions" wx:if="{{editingId !== item.id}}">
          <button class="p-action-btn" size="mini"
            bindtap="startEdit" data-id="{{item.id}}" data-name="{{item.name}}" data-price="{{item.price}}" data-category="{{item.category}}" data-stock="{{item.stock}}">编辑</button>
          <button class="p-action-btn {{item.is_available ? 'off' : 'on'}}" size="mini"
            bindtap="toggleProduct" data-id="{{item.id}}" data-available="{{item.is_available}}">
            {{item.is_available ? '下架' : '上架'}}
          </button>
          <button class="p-action-btn delete" size="mini"
            bindtap="deleteProduct" data-id="{{item.id}}" data-name="{{item.name}}">删除</button>
        </view>
      </view>
    </view>

    <!-- 标签排序 -->
    <view class="section-header" style="margin-top: 40rpx;">
      <text class="section-title">标签排序（{{categoryOrder.length}}）</text>
    </view>
    <view class="category-order-list">
      <view class="cat-order-item" wx:for="{{categoryOrder}}" wx:key="*this">
        <text class="cat-order-name">{{item}}</text>
        <view class="cat-order-btns">
          <button class="p-action-btn sort-btn" size="mini" bindtap="moveCategoryUp" data-cat="{{item}}">↑</button>
          <button class="p-action-btn sort-btn" size="mini" bindtap="moveCategoryDown" data-cat="{{item}}">↓</button>
        </view>
      </view>
    </view>
  </scroll-view>
  </swiper-item>

  <swiper-item>
  <!-- ====== 快速录单 ====== -->
  <view class="content qs-content">
    <view class="qs-header">
      <text class="qs-header-title">📋 快速录单</text>
      <text class="qs-header-desc">记录线下收款，自动计入今日营收和销量</text>
    </view>

    <!-- 商品列表 -->
    <view class="qs-product-list">
      <view class="qs-item {{qsCart[item.id] ? 'selected' : ''}}"
        wx:for="{{qsProducts}}" wx:key="id">
        <image class="qs-item-img" src="{{item.image}}" mode="aspectFill"
          wx:if="{{item.image}}" />
        <view class="qs-item-img qs-item-img-placeholder" wx:else>🍞</view>
        <view class="qs-item-info">
          <text class="qs-item-name">{{item.name}}</text>
          <text class="qs-item-meta">{{item.category}} · 库存 {{item.stock}}</text>
          <text class="qs-item-price">¥{{item.price}}</text>
        </view>
        <view class="qs-qty-ctrl">
          <view class="qs-qty-btn minus {{qsCart[item.id] ? '' : 'disabled'}}"
            bindtap="qsChange" data-id="{{item.id}}" data-delta="-1">−</view>
          <input class="qs-qty-input" type="number" value="{{qsCart[item.id] || ''}}" placeholder="0"
            bindinput="qsInputQty" data-id="{{item.id}}" />
          <view class="qs-qty-btn plus"
            bindtap="qsChange" data-id="{{item.id}}" data-delta="1">+</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{qsProducts.length === 0}}">
      <text>暂无在售商品</text>
    </view>

    <!-- 底部汇总栏 -->
    <view class="qs-summary">
      <view class="qs-summary-info">
        <text class="qs-summary-item">已选 <text class="qs-summary-num">{{qsCount}}</text> 件</text>
        <text class="qs-summary-item">合计 <text class="qs-summary-num">¥{{qsTotal}}</text></text>
      </view>
      <button class="qs-submit-btn" bindtap="qsSubmit"
        disabled="{{qsCount === 0 || qsSubmitting}}"
        loading="{{qsSubmitting}}">确认录入</button>
    </view>
  </view>
  </swiper-item>

  <swiper-item>
  <!-- ====== 营收看板 ====== -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{true}}">
    <!-- 日期选择栏 -->
    <view class="dash-date-bar">
      <view class="date-btn {{dashType === 'day' ? 'active' : ''}}" bindtap="setDashType" data-type="day">日</view>
      <view class="date-btn {{dashType === 'month' ? 'active' : ''}}" bindtap="setDashType" data-type="month">月</view>
      <view class="date-btn {{dashType === 'year' ? 'active' : ''}}" bindtap="setDashType" data-type="year">年</view>
      <picker wx:if="{{dashType === 'month'}}" class="date-picker" mode="date" fields="month" value="{{dashboard.dateForPicker || (dashboard.date + '-01')}}" bindchange="onDateChange">
        <view class="date-pick-text">{{dashboard.date || '选择月份'}} ▾</view>
      </picker>
      <picker wx:elif="{{dashType === 'year'}}" class="date-picker" mode="date" fields="year" value="{{dashboard.dateForPicker || (dashboard.date + '-01-01')}}" bindchange="onDateChange">
        <view class="date-pick-text">{{dashboard.date || '选择年份'}} ▾</view>
      </picker>
      <picker wx:else class="date-picker" mode="date" value="{{dashboard.date}}" bindchange="onDateChange">
        <view class="date-pick-text">{{dashboard.date || '选择日期'}} ▾</view>
      </picker>
      <view class="date-btn today-btn" bindtap="goToday">今天</view>
    </view>

    <!-- 当月/当年汇总 -->
    <view class="dash-summary" wx:if="{{dashType === 'month' || dashType === 'year'}}">
      <view class="dash-sum-card">
        <text class="dash-num big">¥{{dashType === 'month' ? dashboard.monthSummary.totalRevenue : dashboard.yearSummary.totalRevenue}}</text>
        <text class="dash-label">{{dashType === 'month' ? '本月营收' : '本年营收'}}</text>
      </view>
      <view class="dash-sum-card">
        <text class="dash-num big">{{dashType === 'month' ? dashboard.monthSummary.totalOrders : dashboard.yearSummary.totalOrders}}</text>
        <text class="dash-label">{{dashType === 'month' ? '本月总订单' : '本年总订单'}}</text>
      </view>
    </view>

    <!-- 当日数据 -->
    <view class="dash-grid" wx:if="{{dashType === 'day' && dashboard.dayStats.length > 0}}">
      <view class="dash-card" wx:for="{{dashboard.dayStats}}" wx:key="day">
        <text class="dash-num">¥{{item.revenue || 0}}</text>
        <text class="dash-label">当日营收</text>
      </view>
    </view>

    <!-- 当日订单列表 -->
    <view class="dash-order-list" wx:if="{{dashType === 'day' && dashboard.todayOrders.length > 0}}">
      <view class="prod-header">📋 当日订单 ({{dashboard.todayOrders.length}} 笔)</view>
      <view class="dash-order-card" wx:for="{{dashboard.todayOrders}}" wx:key="id">
        <view class="dash-order-row">
          <text class="dash-order-no">{{item.order_no}}</text>
          <text class="order-source-tag" wx:if="{{item.source === 'offline'}}">线下</text>
          <text class="dash-order-status {{item.status === 'completed' ? 's-green' : item.status === 'refunded' ? 's-red' : item.status === 'refund_pending' ? 's-orange' : ''}}">{{item._statusText}}</text>
          <text class="dash-order-price">¥{{item.total_price}}</text>
        </view>
        <text class="dash-order-items" wx:if="{{item._itemsSummary}}">{{item._itemsSummary}}</text>
      </view>
    </view>

    <!-- 商品月销量 -->
    <view class="dash-product-list" wx:if="{{dashboard.productSales.length > 0}}">
      <view class="prod-header">🏆 商品{{dashType === 'month' ? '月' : dashType === 'year' ? '年' : '日'}}销量 ({{dashboard.salesPeriod}})</view>
      <view class="prod-item" wx:for="{{dashboard.productSales}}" wx:key="id">
        <text class="prod-name">{{item.name}}</text>
        <view class="prod-stats">
          <text class="prod-qty">{{item.quantity}} 个</text>
          <text class="prod-revenue">¥{{item.revenue}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{!dashboard}}">加载中...</view>
  </scroll-view>
  </swiper-item>
</swiper>

  <!-- ====== 快捷调库存 · 批量面板（方案B） ======
       放在 swiper 外面：swiper-item 内部有 transform，fixed 定位会被裁剪/偏移 -->
  <view class="stock-panel-mask" wx:if="{{showStockPanel}}" bindtap="closeStockPanel" catchtouchmove="noop">
    <view class="stock-panel" catchtap="noop">
      <view class="stock-panel-header">
        <text class="stock-panel-title">快捷调库存</text>
        <text class="stock-panel-close" bindtap="closeStockPanel">✕</text>
      </view>
      <view class="stock-panel-presets">
        <text class="preset-label">常用值</text>
        <view class="preset-chip" wx:for="{{stockPresets}}" wx:key="*this"
          bindtap="fillStockValue" data-value="{{item}}">{{item}}</view>
      </view>
      <view class="stock-panel-tip">🔒 锁定（🔓→🔒）的商品不参与常用值填充和保存，适合"展示但不卖"的置0商品</view>
      <scroll-view scroll-y class="stock-panel-list">
        <view class="stock-panel-row {{item.locked ? 'locked' : ''}}" wx:for="{{stockPanelRows}}" wx:key="id">
          <text class="sp-name">{{item.name}}</text>
          <text class="sp-locked-tag" wx:if="{{item.locked}}">保持0</text>
          <text class="sp-origin" wx:if="{{item.dirty && !item.locked}}">原{{item.stock}}</text>
          <input class="sp-input" type="number" value="{{item.value}}"
            data-idx="{{index}}" bindinput="onStockPanelInput"
            disabled="{{item.locked}}" />
          <view class="sp-lock {{item.locked ? 'locked' : ''}}" catchtap="toggleStockLock"
            data-idx="{{index}}">{{item.locked ? '🔒' : '🔓'}}</view>
        </view>
        <view class="empty" wx:if="{{stockPanelRows.length === 0}}">暂无商品</view>
      </scroll-view>
      <view class="stock-panel-footer">
        <button class="sp-save-btn" size="mini" bindtap="saveStockPanel"
          disabled="{{stockPanelSaving}}" loading="{{stockPanelSaving}}">全部保存</button>
      </view>
    </view>
  </view>
</view>
