/* ===== 登录页 ===== */
.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background: #f5f5f5;
}
.login-card {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}
.login-title { font-size: 40rpx; font-weight: bold; display: block; margin-bottom: 8rpx; }
.login-sub { font-size: 26rpx; color: #999; display: block; margin-bottom: 40rpx; }
.login-input {
  border: 1px solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  line-height: 80rpx;
  height: 80rpx;
  width: 100%;
  box-sizing: border-box;
}
.login-error { color: #e74c3c; font-size: 24rpx; margin-top: 12rpx; display: block; }
.login-btn {
  margin-top: 30rpx;
  background: #333;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
  width: 100%;
}

/* ===== 管理面板 ===== */
.admin-page { height: 100vh; background: #f5f5f5; overflow: hidden; display: flex; flex-direction: column; }

/* Tab 栏 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1px solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
}
.tab-item.active { color: #333; font-weight: bold; border-bottom: 4rpx solid #333; }
.logout-tab { color: #e74c3c; flex: 0.6; }

/* 内容区 */
.content { padding: 20rpx; height: 100%; box-sizing: border-box; }

/* 订单筛选 */
.filter-scroll { white-space: nowrap; padding: 16rpx 0; }
.filter-item {
  display: inline-block;
  padding: 10rpx 32rpx 10rpx 24rpx;   /* 右侧多留点位置给角标 */
  margin-right: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  position: relative;
}
.filter-item.active { background: #333; color: #fff; }

.filter-badge {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  right: 4rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 20rpx;
  min-width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  border-radius: 14rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}
/* 角标颜色不随 active 变化 — 制作中等核心关注订单保持红色 */

/* 新订单提醒横幅 */
.new-order-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff3cd;
  border: 1px solid #ffc107;
  border-radius: 10rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
  animation: bannerSlide 0.3s ease;
}
@keyframes bannerSlide {
  from { transform: translateY(-20rpx); opacity: 0; }
  to   { transform: translateY(0); opacity: 1; }
}
.banner-text { font-size: 26rpx; color: #856404; font-weight: bold; }
.banner-close { font-size: 28rpx; color: #c79002; padding: 0 8rpx; }

/* 轮询状态栏 */
.poll-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: #999;
}
.poll-indicator {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.poll-indicator.active {
  background: #27ae60;
  animation: pollPulse 2s ease-in-out infinite;
}
@keyframes pollPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}
.poll-text { flex: 1; }
.poll-refresh {
  color: #f5a623;
  padding: 4rpx 16rpx;
  border: 1px solid #f5a623;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 订单卡片 */
.order-list { margin-top: 16rpx; }
.admin-swiper { flex: 1; }
.order-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-header { display: flex; justify-content: space-between; margin-bottom: 12rpx; }
.order-no { font-size: 24rpx; color: #999; font-family: monospace; }
.order-status { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 4rpx; }
.status-pending { background: #fff3cd; color: #856404; }
.status-preparing { background: #cce5ff; color: #004085; }
.status-ready { background: #d4edda; color: #155724; }
.status-completed { background: #e2e3e5; color: #383d41; }
.status-refunded  { background: #f8d7da; color: #721c24; }
.order-items-row { font-size: 28rpx; color: #333; font-weight: bold; display: block; }
.order-item-name { display: inline-block !important; font-size: 28rpx; color: #333; font-weight: bold; margin-right: 8rpx; }
.admin-temp {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 1rpx 6rpx;
  margin-left: 4rpx;
  display: inline-block !important;
}
.temp-cold { color: #1976d2; background: #e3f2fd; }
.temp-hot  { color: #bf360c; background: #fff3e0; }

/* 订单底部：左侧信息 + 右侧取餐码 */
.order-bottom {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 8rpx;
  gap: 16rpx;
}
.order-bottom-left {
  flex: 1;
  min-width: 0;
}
.order-info { font-size: 24rpx; color: #666; }
.order-remark { font-size: 24rpx; color: #ff9800; margin-top: 2rpx; word-break: break-all; }
.order-time { font-size: 22rpx; color: #999; margin-top: 2rpx; }
.order-pickup {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #e53935;
  font-weight: bold;
  white-space: nowrap;
  background: rgba(229, 57, 53, 0.1);
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  align-self: flex-start;
}
.order-actions { margin-top: 16rpx; }
.action-btn { font-size: 22rpx !important; }
.ready-btn { background: #27ae60 !important; color: #fff !important; }
.complete-btn { background: #333 !important; color: #fff !important; }

/* 商品管理 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}
.section-title { font-size: 28rpx; font-weight: bold; }
.header-btns { display: flex; gap: 12rpx; align-items: center; }
.add-btn { background: #333 !important; color: #fff !important; font-size: 22rpx !important; }
.reset-btn { background: #fff !important; color: #e74c3c !important; border: 1px solid #e74c3c !important; font-size: 22rpx !important; }

.add-form {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.form-input {
  border: 1px solid #e0e0e0;
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  /* 显式 height + line-height：
     小程序原生 input 没有显式高度时会按内容撑开，padding+font 算下来高度不够，
     导致 placeholder/输入文字垂直居中并被上下截断。强制给一个安全高度。 */
  height: 80rpx;
  min-height: 80rpx;
  line-height: 56rpx;
}
.form-textarea {
  border: 1px solid #e0e0e0;
  border-radius: 6rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 80rpx;
}
/* 图库缩略图横向滚动 */
.gallery-thumbs {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}
.gallery-thumb-item {
  display: inline-block;
  position: relative;
  width: 120rpx; height: 120rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f5f5f5;
}
.gallery-thumb-img {
  width: 100%; height: 100%;
}
.gallery-thumb-del {
  position: absolute;
  top: 4rpx; right: 4rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.form-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.form-label { font-size: 26rpx; color: #666; }
.picker-val { font-size: 26rpx; padding: 8rpx 16rpx; background: #f5f5f5; border-radius: 6rpx; }
.form-btns { display: flex; gap: 16rpx; margin-top: 8rpx; }
.form-btn { font-size: 24rpx !important; }
.form-btn.confirm { background: #333 !important; color: #fff !important; }
.form-btn.cancel { background: #e0e0e0 !important; }

/* 图片上传 */
.upload-row { margin-bottom: 12rpx; }
.upload-btn {
  font-size: 22rpx !important;
  background: #f0f0f0 !important;
  color: #333 !important;
  border: 2rpx dashed #ccc !important;
  border-radius: 8rpx !important;
  padding: 8rpx 16rpx !important;
}
.upload-preview {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  background: #f5f5f5;
}

.product-list { margin-top: 8rpx; }
.product-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}
.product-card.disabled { opacity: 0.5; }
.product-card.editing { align-items: flex-start; }
.product-img { width: 80rpx; height: 80rpx; border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; }
.product-info { flex: 1; min-width: 0; }
.product-name { font-size: 28rpx; font-weight: bold; display: block; }
.product-cat { font-size: 22rpx; color: #999; }
.product-stock { font-size: 22rpx; color: #999; margin-top: 2rpx; display: block; }
.product-price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 4rpx; }
.product-price { font-size: 28rpx; color: #e74c3c; font-weight: bold; }
.product-sales { font-size: 22rpx; color: #999; }

/* 编辑模式 */
.edit-layout { display: flex; }
.edit-left {
  width: 160rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.edit-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
  margin-bottom: 10rpx;
}
.edit-left .upload-btn { font-size: 18rpx !important; padding: 4rpx 10rpx !important; }
.edit-right { flex: 1; min-width: 0; }
.edit-row-flex { display: flex; align-items: center; margin-bottom: 10rpx; }
.edit-label-left {
  font-size: 24rpx;
  color: #666;
  width: 64rpx;
  flex-shrink: 0;
  text-align: right;
  margin-right: 10rpx;
}
.edit-input-right {
  flex: 1;
  min-width: 0;
  border: 1px solid #e0e0e0;
  border-radius: 6rpx;
  padding: 8rpx 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
  /* 关键：edit-row-flex 是 flex+align-items:center，input 在 flex 容器里
     会被压缩到与 label 同高，没有足够空间放文字，导致文字上下截断。
     给一个不被 flex 压缩的 min-height + 明确 line-height 即可。 */
  height: 56rpx;
  min-height: 56rpx;
  line-height: 40rpx;
}
.edit-btns { display: flex; gap: 16rpx; margin-top: 14rpx; justify-content: flex-end; }
.edit-confirm { font-size: 24rpx !important; background: #27ae60 !important; color: #fff !important; }
.edit-cancel-btn { font-size: 24rpx !important; background: #e0e0e0 !important; }
.edit-row-desc { align-items: flex-start !important; }
.edit-textarea {
  height: auto !important;
  min-height: 80rpx !important;
  line-height: 1.4 !important;
  padding: 8rpx 12rpx !important;
}
.edit-gallery-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 14rpx;
  margin-bottom: 8rpx;
}
.edit-gallery-label {
  font-size: 22rpx;
  color: #666;
}
.product-actions { display: flex; flex-direction: column; gap: 8rpx; margin-left: 12rpx; }
.p-action-btn { font-size: 20rpx !important; min-width: 80rpx; }
.p-action-btn.off { background: #e74c3c !important; color: #fff !important; }
.p-action-btn.on { background: #27ae60 !important; color: #fff !important; }
.p-action-btn.delete { background: #fff !important; color: #999 !important; border: 1px solid #ddd !important; }

/* 排序箭头（商品信息区右侧） */
.sort-handle {
  display: flex;
  flex-direction: row;
  gap: 4rpx;
  margin-left: 12rpx;
}
.sort-arrow {
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #999;
  background: #f5f5f5; border-radius: 6rpx;
}
.product-info-top {
  display: flex; align-items: flex-start;
}
.product-info-text {
  flex: 1;
}

/* 标签排序 */
.category-order-list { padding: 0 24rpx; }
.cat-order-item {
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; padding: 20rpx 24rpx; margin-bottom: 8rpx;
  border-radius: 12rpx; box-shadow: 0 1rpx 6rpx rgba(0,0,0,0.04);
}
.cat-order-name { font-size: 28rpx; color: #333; }
.cat-order-btns { display: flex; gap: 8rpx; }

/* 营收看板 */
.dash-header { text-align: center; padding: 24rpx 0; }
.dash-date { font-size: 22rpx; color: #999; display: block; }
.dash-title { font-size: 32rpx; font-weight: bold; }
.dash-grid { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.dash-card {
  width: calc(50% - 12rpx);
  background: #fff;
  border-radius: 12rpx;
  padding: 32rpx 16rpx;
  text-align: center;
  margin: 0 6rpx 12rpx 6rpx;
  box-sizing: border-box;
}
.dash-card.highlight { background: #333; width: calc(100% - 12rpx); }
.dash-card.highlight .dash-num { color: #fff; }
.dash-card.highlight .dash-label { color: #aaa; }
.dash-num { font-size: 36rpx; font-weight: bold; display: block; }
.dash-label { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

/* 快速录单 */
.qs-content { padding-bottom: 160rpx; overflow-y: auto; }
.qs-header { padding: 16rpx 0 24rpx; }
.qs-header-title { font-size: 32rpx; font-weight: bold; display: block; }
.qs-header-desc { font-size: 24rpx; color: #999; display: block; margin-top: 6rpx; }

.qs-product-list { margin-bottom: 24rpx; }
.qs-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #fff;
  transition: border-color 0.2s;
}
.qs-item.selected { border-color: #f5a623; background: #fef9f0; }
.qs-item-img {
  width: 72rpx; height: 72rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}
.qs-item-img-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #f0f0f0;
}
.qs-item-info { flex: 1; min-width: 0; }
.qs-item-name { font-size: 28rpx; font-weight: bold; display: block; }
.qs-item-meta { font-size: 22rpx; color: #999; display: block; margin-top: 2rpx; }
.qs-item-price { font-size: 28rpx; color: #e74c3c; font-weight: bold; display: block; }

.qs-qty-ctrl {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.qs-qty-btn {
  width: 48rpx; height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}
.qs-qty-btn.minus { background: #f0f0f0; color: #666; }
.qs-qty-btn.minus.disabled { opacity: 0.4; }
.qs-qty-btn.plus { background: #f5a623; color: #fff; }
.qs-qty-num { font-size: 28rpx; font-weight: bold; min-width: 36rpx; text-align: center; }

.qs-summary {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-top: 2rpx solid #f0f0f0;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  z-index: 100;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.qs-summary-info { display: flex; gap: 32rpx; }
.qs-summary-item { font-size: 26rpx; color: #666; }
.qs-summary-num { font-size: 32rpx; color: #f5a623; font-weight: bold; }
.qs-submit-btn {
  background: #f5a623 !important;
  color: #333 !important;
  border-radius: 40rpx !important;
  font-size: 28rpx !important;
  font-weight: bold !important;
  padding: 0 40rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
}
.qs-submit-btn[disabled] { background: #ccc !important; }

.empty { text-align: center; padding: 80rpx 0; color: #999; font-size: 28rpx; }

.load-more {
  text-align: center;
  padding: 24rpx;
  color: #576b95;
  font-size: 28rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin: 16rpx 24rpx;
}
