<!-- 我的页面 -->
<view class="profile-page tab-bar-page">

  <!-- 顶部用户信息区 -->
  <view class="user-header">
    <view class="user-bg"></view>
    <view class="user-info">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image>
      <view class="user-detail">
        <text class="nickname">{{userInfo.nickname}}</text>
      </view>
      <view class="arrow" bindtap="goSettings">›</view>
    </view>
  </view>

  <!-- 积分卡片 -->
  <view class="asset-card">
    <view class="asset-item">
      <text class="asset-num">{{userInfo.points}}</text>
      <text class="asset-label">积分</text>
    </view>
  </view>

  <!-- 订单管理 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="goAllOrders">全部订单 ›</text>
    </view>
    <view class="order-grid">
      <view class="order-item" bindtap="goOrders" data-status="pending">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/svg/order-pending.svg" mode="aspectFit"></image>
          <view class="badge" wx:if="{{orderCount.pending > 0}}">{{orderCount.pending}}</view>
        </view>
        <text class="order-text">待支付</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="preparing">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/svg/order-preparing.svg" mode="aspectFit"></image>
          <view class="badge" wx:if="{{orderCount.preparing > 0}}">{{orderCount.preparing}}</view>
        </view>
        <text class="order-text">制作中</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="ready">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/svg/order-ready.svg" mode="aspectFit"></image>
          <view class="badge" wx:if="{{orderCount.ready > 0}}">{{orderCount.ready}}</view>
        </view>
        <text class="order-text">待取餐</text>
      </view>
      <view class="order-item" bindtap="goOrders" data-status="completed">
        <view class="order-icon-wrap">
          <image class="order-icon" src="/images/svg/order-completed.svg" mode="aspectFit"></image>
        </view>
        <text class="order-text">已完成</text>
      </view>
    </view>
  </view>

  <!-- 常用工具 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">常用工具</text>
    </view>
    <view class="tool-list">
      <view class="tool-item" bindtap="goContact">
        <image class="tool-icon" src="/images/svg/tool-contact.svg" mode="aspectFit"></image>
        <text class="tool-name">联系客服</text>
        <text class="tool-arrow">›</text>
      </view>
      <view class="tool-item" bindtap="goAbout">
        <image class="tool-icon" src="/images/svg/tool-about.svg" mode="aspectFit"></image>
        <text class="tool-name">关于我们</text>
        <text class="tool-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部留白 -->
  <view class="bottom-spacer"></view>

  <!-- 自定义悬浮TabBar -->
  <custom-tab-bar></custom-tab-bar>

  <!-- 联系门店弹窗（复用 order-detail 同款） -->
  <view class="modal-mask" wx:if="{{showCallModal}}" bindtap="closeCallModal">
    <view class="modal-card" catchtap="">
      <view class="modal-title">联系门店</view>
      <view class="modal-content">
        <view class="modal-line modal-store-name">大力馒头铺·信息港店</view>
        <view class="modal-line modal-store-phone">电话：189-2427-3942</view>
      </view>
      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="closeCallModal">取消</view>
        <view class="modal-btn confirm" bindtap="doCallPhone">拨打</view>
      </view>
    </view>
  </view>
</view>
