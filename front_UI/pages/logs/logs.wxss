page {
  background: #f5f5f5;
}

.profile-page {
  min-height: 100vh;
}

/* ========== 顶部用户信息区 ========== */
.user-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #f5a623 0%, #e6951c 100%);
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
  background: #fff;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.member-tag-row {
  display: flex;
}

.member-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.3);
  color: #fff;
}

.member-tag.gold {
  background: linear-gradient(135deg, #ffd700, #ffb300);
  color: #8b6914;
  font-weight: bold;
}

.member-tag.none {
  background: rgba(255,255,255,0.25);
  color: rgba(255,255,255,0.9);
}

.arrow {
  font-size: 48rpx;
  color: rgba(255,255,255,0.7);
  padding: 10rpx;
}

/* ========== 会员资产卡片 ========== */
.asset-card {
  margin: -20rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}

.asset-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.asset-label {
  font-size: 24rpx;
  color: #999;
}

.asset-divider {
  width: 1rpx;
  height: 50rpx;
  background: #eee;
}

/* ========== 通用区块 ========== */
.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* ========== 订单网格 ========== */
.order-grid {
  display: flex;
  padding: 24rpx 0;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.order-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-icon {
  font-size: 44rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.order-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* ========== 工具列表 ========== */
.tool-list {
  padding: 0 8rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 44rpx;
  text-align: center;
}

.tool-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.tool-extra {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.tool-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 40rpx;
}

.bottom-section {
  margin-bottom: 40rpx;
}
