page {
  background: #f5f5f5;
}

.profile-page {
  min-height: 100vh;
}

/* ========== 顶部用户信息区 ========== */
.user-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F3D624;
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 10rpx solid #fff;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: inline;
  padding: 6rpx 0;
}

.nickname-edit-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 8rpx;
  opacity: 0.7;
  vertical-align: middle;
}

/* ========== 积分卡片 ========== */
.asset-card {
  margin: -20rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.10);
  position: relative;
  z-index: 2;
}

.asset-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.asset-label {
  font-size: 24rpx;
  color: #999;
}

/* ========== 通用区块 ========== */
.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.10);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* ========== 订单网格 ========== */
.order-grid {
  display: flex;
  padding: 24rpx 0;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.order-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-icon {
  width: 44rpx;
  height: 44rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.order-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* ========== 工具列表 ========== */
.tool-list {
  padding: 0 8rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.tool-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.tool-extra {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.tool-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 40rpx;
}

/* ========== 通用弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.modal-card {
  position: relative;
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.18);
}
.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  padding: 32rpx 0 12rpx;
  color: #333;
}
.modal-content {
  padding: 0 40rpx 36rpx;
}
.modal-line {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  text-align: center;
}
.modal-store-name {
  font-weight: bold;
  margin-bottom: 4rpx;
}
.modal-store-phone {
  color: #666;
}
.modal-actions {
  display: flex;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-right: 1rpx solid #eee;
  box-sizing: border-box;
}
.modal-btn:last-child {
  border-right: none;
}
.modal-btn.cancel {
  color: #666;
}
.modal-btn.confirm {
  color: #576b95;
  font-weight: bold;
}

/* ========== 昵称弹窗输入框 ========== */
.modal-avatar-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 30rpx;
}

.modal-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #eee;
}

.modal-avatar-hint {
  font-size: 26rpx;
  color: #576b95;
  margin-left: 24rpx;
}

.edit-input.wide {
  width: 100%;
  font-size: 28rpx;
  padding: 0 20rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  box-sizing: border-box;
}

