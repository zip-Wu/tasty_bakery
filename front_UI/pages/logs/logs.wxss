page {
  background: #f5f5f5;
}

.profile-page {
  min-height: 100vh;
}

/* ========== 顶部用户信息区 ========== */
.user-header {
  position: relative;
  padding: 60rpx 30rpx 40rpx;
  overflow: hidden;
}

.user-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F3D624;
}

.user-info {
  position: relative;
  display: flex;
  align-items: center;
  z-index: 1;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.8);
  background: #fff;
}

.user-detail {
  flex: 1;
  margin-left: 24rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
}

.arrow {
  font-size: 48rpx;
  color: rgba(51, 51, 51, 0.55);
  padding: 10rpx;
}

/* ========== 积分卡片 ========== */
.asset-card {
  margin: -20rpx 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 2;
}

.asset-item {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.asset-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.asset-label {
  font-size: 24rpx;
  color: #999;
}

/* ========== 通用区块 ========== */
.section {
  margin: 20rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 28rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.section-more {
  font-size: 24rpx;
  color: #999;
}

/* ========== 订单网格 ========== */
.order-grid {
  display: flex;
  padding: 24rpx 0;
}

.order-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
}

.order-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-icon {
  width: 44rpx;
  height: 44rpx;
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

.order-text {
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
}

/* ========== 工具列表 ========== */
.tool-list {
  padding: 0 8rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 28rpx 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.tool-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.tool-extra {
  font-size: 24rpx;
  color: #999;
  margin-right: 10rpx;
}

.tool-arrow {
  font-size: 28rpx;
  color: #ccc;
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 40rpx;
}
