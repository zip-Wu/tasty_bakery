<!-- 订单详情页 -->
<view class="order-detail-page">
  <!-- 订单状态追踪 -->
  <view class="status-tracker">
    <view class="status-bg">
      <view class="status-icon">{{statusIcon}}</view>
      <view class="status-text">{{order.statusText}}</view>
    </view>

    <!-- 时间线进度 -->
    <view class="timeline">
      <view class="timeline-item {{order.createdAt ? 'done' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">订单创建</text>
          <text class="timeline-time" wx:if="{{order.createdAtDisplay}}">{{order.createdAtDisplay}}</text>
        </view>
      </view>

      <view class="timeline-item {{order.paidAt ? 'done active' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">支付成功</text>
          <text class="timeline-time" wx:if="{{order.paidAtDisplay}}">{{order.paidAtDisplay}}</text>
        </view>
      </view>

      <view class="timeline-item {{order.acceptedAt ? 'done active' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">商家接单</text>
          <text class="timeline-time" wx:if="{{order.acceptedAtDisplay}}">{{order.acceptedAtDisplay}}</text>
        </view>
      </view>

      <view class="timeline-item {{order.status === 'ready' || order.status === 'completed' ? 'done active' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">制作完成</text>
          <text class="timeline-time" wx:if="{{order.readyAtDisplay}}">{{order.readyAtDisplay}}</text>
        </view>
      </view>

      <view class="timeline-item {{order.status === 'completed' ? 'done active' : ''}}">
        <view class="timeline-dot"></view>
        <view class="timeline-content">
          <text class="timeline-title">已取餐</text>
          <text class="timeline-time" wx:if="{{order.completedAtDisplay}}">{{order.completedAtDisplay}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 门店信息 -->
  <view class="info-card">
    <view class="card-title">取餐信息</view>
    <view class="store-row">
      <text class="store-name">{{order.storeName}}</text>
    </view>
    <view class="store-addr">{{order.address}}</view>
  </view>

  <!-- 商品清单 -->
  <view class="info-card">
    <view class="card-title">订单商品</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
        <image class="goods-img" src="{{item.image}}" mode="aspectFill"></image>
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-price">¥{{item.price}}</text>
        </view>
        <text class="goods-qty">x{{item.quantity}}</text>
      </view>
    </view>
    <view class="goods-total">
      <text>共 {{order.totalQuantity}} 件</text>
      <text class="total-price">¥{{order.totalPrice}}</text>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="info-card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{order.createdAtDisplay}}</text>
    </view>
    <view class="info-row" wx:if="{{order.paidAtDisplay}}">
      <text class="info-label">支付时间</text>
      <text class="info-value">{{order.paidAtDisplay}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="bottom-actions">
    <view class="action-btn secondary" bindtap="callStore">联系门店</view>
    <view class="action-btn primary" wx:if="{{order.status === 'pending'}}" bindtap="goPay">立即支付</view>
    <view class="action-btn primary" wx:if="{{order.status === 'ready'}}" bindtap="confirmPickup">确认取餐</view>
  </view>
</view>