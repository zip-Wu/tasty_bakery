page {
  background: #f5f5f5;
  padding-bottom: 156rpx;
}

/* ========== 状态追踪区 ========== */
.status-tracker {
  background: #F3D624;
  padding: 60rpx 40rpx 40rpx;
}

.status-bg {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.status-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 16rpx;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.pickup-code-big {
  font-size: 72rpx;
  font-weight: bold;
  color: #1a1a1a;
  letter-spacing: 20rpx;
  margin-top: 8rpx;
  border: 4rpx solid rgba(0,0,0,0.12);
  border-radius: 16rpx;
  padding: 8rpx 32rpx 8rpx 48rpx;
  display: inline-block;
  background: rgba(255,255,255,0.35);
}

/* ========== 时间线 ========== */
.timeline {
  background: rgba(0, 0, 0, 0.06);
  border-radius: 16rpx;
  padding: 30rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0;
  opacity: 0.4;
}

.timeline-item.done {
  opacity: 1;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  margin-right: 20rpx;
  margin-top: 6rpx;
  flex-shrink: 0;
}

.timeline-item.done .timeline-dot {
  background: #333;
}

.timeline-item.active .timeline-dot {
  background: #333;
  box-shadow: 0 0 0 6rpx rgba(51, 51, 51, 0.15);
}

.timeline-content {
  flex: 1;
}

.timeline-title {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.timeline-time {
  font-size: 22rpx;
  color: rgba(51, 51, 51, 0.7);
}

/* ========== 信息卡片 ========== */
.info-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* ========== 门店信息 ========== */
.store-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.store-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.store-addr {
  font-size: 26rpx;
  color: #999;
}

/* ========== 商品列表 ========== */
.goods-list {
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.goods-img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #f5f5f5;
}

.goods-info {
  flex: 1;
  margin-left: 16rpx;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.item-temp {
  font-size: 20rpx;
  border-radius: 8rpx;
  padding: 1rpx 8rpx;
  margin-left: 6rpx;
}
.temp-cold { color: #1976d2; background: #e3f2fd; }
.temp-hot  { color: #bf360c; background: #fff3e0; }

.goods-price {
  font-size: 26rpx;
  color: #e53935;
  font-weight: bold;
}

.goods-qty {
  font-size: 26rpx;
  color: #999;
}

.goods-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

.total-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* ========== 订单信息 ========== */
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
}

/* ========== 底部操作栏 ========== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  min-height: 120rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding: 0 30rpx 16rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  gap: 20rpx;
}

.action-btn {
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border-radius: 50rpx;
}

.action-btn.secondary {
  border: 2rpx solid #ddd;
  color: #666;
}

.action-btn.primary {
  background: #F3D624;
  color: #333;
  font-weight: bold;
}

.action-btn.danger {
  background: #e74c3c;
  color: #fff;
}

.action-btn.disabled {
  background: #e0e0e0;
  color: #999;
}

/* ========== 倒计时提示 ========== */
.countdown-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: bold;
  color: #8B4513;
  background: rgba(0, 0, 0, 0.12);
  padding: 16rpx 24rpx;
  margin: 0 24rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.countdown-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.countdown-text {
  font-size: 26rpx;
  font-weight: bold;
  color: #8B4513;
}

/* ========== 联系门店弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-card {
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.18);
}
.modal-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  padding: 32rpx 0 12rpx;
  color: #333;
}
.modal-content {
  padding: 0 40rpx 36rpx;
}
.modal-line {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  text-align: center;
}
.modal-store-name {
  font-weight: bold;
  margin-bottom: 4rpx;
}
.modal-store-phone {
  color: #666;
}
.modal-actions {
  display: flex;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  border-right: 1rpx solid #eee;
  box-sizing: border-box;
}
.modal-btn:last-child {
  border-right: none;
}
.modal-btn.cancel {
  color: #666;
}
.modal-btn.confirm {
  color: #576b95;
  font-weight: bold;
}

.modal-btn.confirm.disabled {
  color: #bbb;
  font-weight: normal;
}

/* ========== 退款理由弹窗 ========== */
.refund-info {
  background: #fff8e1;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.refund-info-line {
  font-size: 26rpx;
  color: #8B4513;
  display: block;
  line-height: 1.6;
}

.refund-reason-input {
  width: 100%;
  min-height: 160rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}

.refund-reason-count {
  font-size: 22rpx;
  color: #bbb;
  text-align: right;
  display: block;
  margin-top: 8rpx;
}

/* ========== 取餐通知订阅 ========== */
.notify-section {
  margin: 20rpx 30rpx;
}

.notify-done {
  background: #e8f5e9;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
  font-size: 26rpx;
  color: #2e7d32;
  display: flex;
  align-items: center;
}

.notify-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.notify-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.notify-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.notify-sub {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.notify-btn {
  width: 100%;
  background: #0ab98e;
  color: #fff;
  font-size: 28rpx;
  border-radius: 10rpx;
  padding: 20rpx 0;
  border: none;
}

.notify-divider {
  display: flex;
  align-items: center;
  margin: 28rpx 0;
  color: #ccc;
  font-size: 24rpx;
}

.notify-divider::before,
.notify-divider::after {
  content: '';
  flex: 1;
  height: 1rpx;
  background: #eee;
}

.notify-divider text {
  padding: 0 24rpx;
}

.notify-phone-row {
  display: flex;
  gap: 16rpx;
}

.notify-phone-input {
  flex: 1;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.notify-phone-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #333;
  color: #fff;
  font-size: 26rpx;
  border-radius: 10rpx;
  border: none;
  text-align: center;
  padding: 0;
}

/* 手机号编辑/清除小按钮 */
.phone-mini-btn {
  font-size: 22rpx;
  color: #333;
  background: #f0f0f0;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.phone-mini-btn.clear {
  color: #e53935;
  background: #fff0f0;
}