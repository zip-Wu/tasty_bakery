<!-- 首页 - SVG 图片布局 -->
<view class="home-page">
  <!-- 顶部 Banner（点击5次进入商家管理） -->
  <image class="banner" src="/images/png/banner.png" mode="widthFix" bindtap="onBannerTap"></image>

  <!-- 点餐 / 门店地址 -->
  <view class="service-row">
    <view class="service-card" bindtap="goToOrder">
      <text class="card-icon">🍞</text>
      <text class="card-title">点餐</text>
    </view>
    <view class="service-card" bindtap="goToAddress">
      <text class="card-icon">📍</text>
      <text class="card-title">门店地址</text>
    </view>
  </view>

  <!-- 活动区（绝对定位，固定在 TabBar 上方，活动栏永远靠近 tab） -->
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="activity-scroll">
    <view class="activity-list">
      <view class="activity-item" wx:for="{{activities}}" wx:key="id">
        <image class="activity-img" src="{{item.image}}" mode="aspectFill"></image>
      </view>
    </view>
  </scroll-view>

  <!-- 自定义 TabBar -->
  <custom-tab-bar></custom-tab-bar>
</view>
