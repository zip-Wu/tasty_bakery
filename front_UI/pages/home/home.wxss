/* ===== 首页 - 大力馒头风格（按比例还原） ===== */
page {
  background: #FFEB99;
  margin: 0 !important;
  padding: 0 !important;
}

.home-page {
  padding-bottom: 20rpx;
  padding-top: 0 !important;
  min-height: 100vh;
}

/* ========== 顶部大Banner ========== */
.banner-section {
  width: 100%;
  height: 560rpx;
  overflow: hidden;
  position: relative;
}

.banner-img {
  width: 100%;
  height: 560rpx;
  display: block;
}

/* ========== 两大功能入口卡片（加大） ========== */
.service-cards {
  display: flex;
  margin: 16rpx 20rpx 0;
  gap: 16rpx;
}

.service-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 36rpx 16rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.service-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.service-icon-wrap.pickup {
  background: #E8F5E9;
}

.service-icon-wrap.delivery {
  background: #FFF8E1;
}

.service-emoji-large {
  font-size: 56rpx;
}

.service-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* ========== 会员提示条（稍大） ========== */
.member-tip-bar {
  margin: 16rpx 20rpx 0;
  background: #fff;
  border-radius: 12rpx;
  padding: 22rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.member-tip-text {
  font-size: 25rpx;
  color: #666;
}

.member-code-btn {
  display: flex;
  align-items: center;
  background: #F5F5F5;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  gap: 6rpx;
}

.code-icon {
  font-size: 24rpx;
}

.code-text {
  font-size: 23rpx;
  color: #666;
}

/* ========== 积分商城 + 充值中心（缩小） ========== */
.func-row {
  display: flex;
  margin: 16rpx 20rpx 0;
  gap: 16rpx;
}

.func-item {
  flex: 1;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  min-height: 96rpx;
}

.func-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.func-arrow {
  font-size: 26rpx;
  color: #ccc;
  margin-left: 6rpx;
}

.func-icon-float {
  position: absolute;
  right: 12rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  opacity: 0.25;
}

/* ========== 活动/公告横幅区（更接近正方形） ========== */
.activity-scroll {
  width: 100%;
  height: 240rpx;
  white-space: nowrap;
  margin-top: 16rpx;
  padding-left: 20rpx;
}

.activity-list {
  display: inline-flex;
  width: max-content;
  padding: 0;
  gap: 12rpx;
  padding-right: 20rpx;
}

.activity-item {
  display: inline-block;
  width: 260rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.activity-img {
  width: 260rpx;
  height: 220rpx;
  border-radius: 12rpx;
  display: block;
}