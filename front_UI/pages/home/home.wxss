/* ===== 首页 ===== */
page {
  background: #F3D624;
}

.home-page {
  height: 100vh;        /* 整个视口高度，作为 scroll-view + 浮层 tabBar 的容器 */
  background: #F3D624;
}

/* 滚动容器：负责 banner + 2x2 卡片的上下滚动 */
.home-scroll {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

/* ========== 顶部 Banner ========== */
.banner {
  width: 100%;
  display: block;
}

/* ========== 中间 2x2 功能卡片 ========== */
.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-top: 40rpx;
  row-gap: 28rpx;
}

.card {
  width: 334rpx;          /* 设计稿画板 750px 中卡片宽 334px → 334rpx */
  display: block;
  border-radius: 50rpx;   /* 设计稿白卡圆角很大 */
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 滚动容器底部留白：tabBar 高 110rpx + 距底 48rpx + 视觉余量 22rpx = 180rpx
   跟 app.wxss 里的 .tab-bar-page padding-bottom 同步 */
.scroll-spacer {
  height: 180rpx;
}
