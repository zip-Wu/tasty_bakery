/* ===== 首页 ===== */
page {
  background: #F3D624;
  height: 100vh;
  overflow: hidden;
}

.home-page {
  background: #F3D624;
  padding-bottom: 200rpx;  /* 给悬浮 TabBar 留呼吸空间，超出部分由 page overflow hidden 接管 */
}

/* ========== 顶部 Banner ========== */
.banner {
  width: 100%;
  display: block;
}

/* ========== 门店自提 / 邮寄服务（并排） ========== */
.service-row {
  display: flex;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-top: 24rpx;
}

.service-card {
  width: 334rpx;
}

/* ========== 活动区（横向滚动） ========== */
.activity-scroll {
  width: 100%;
  height: 240rpx;
  white-space: nowrap;
  margin-top: 24rpx;
  padding-left: 28rpx;
}

.activity-list {
  display: inline-flex;
  width: max-content;
  gap: 12rpx;
  padding-right: 28rpx;
}

.activity-item {
  display: inline-block;
  width: 260rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.activity-img {
  width: 260rpx;
  height: 220rpx;
  border-radius: 12rpx;
  display: block;
}
