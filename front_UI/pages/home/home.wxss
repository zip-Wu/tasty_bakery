/* ===== 首页 ===== */
page {
  background: #F3D624;
  height: 100vh;
  overflow: hidden;
}

.home-page {
  position: relative;     /* 作为活动栏 absolute 定位的参照 */
  height: 100vh;          /* 撑满屏幕 */
  background: #F3D624;
}

/* ========== 顶部 Banner ========== */
.banner {
  width: 100%;
  display: block;
}

/* ========== 门店自提 / 邮寄服务（并排） ========== */
.service-row {
  display: flex;
  justify-content: space-between;
  padding: 0 28rpx;
  margin-top: 80rpx;       /* 让功能框下移 */
}

.service-card {
  width: 334rpx;
}

/* ========== 活动区（绝对定位，固定在 TabBar 上方 30rpx） ==========
   关键：position: absolute + bottom: 188rpx
   158rpx 是 TabBar 占用空间 (110rpx 高 + bottom 48rpx) + 30rpx 视觉留白 */
.activity-scroll {
  position: absolute;
  bottom: 188rpx;
  left: 0;
  right: 0;
  width: 100%;
  height: 240rpx;
  white-space: nowrap;
  padding-left: 28rpx;
}

.activity-list {
  display: inline-flex;
  width: max-content;
  gap: 12rpx;
  padding-right: 28rpx;
}

.activity-item {
  display: inline-block;
  width: 260rpx;
  height: 220rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
}

.activity-img {
  width: 260rpx;
  height: 220rpx;
  border-radius: 12rpx;
  display: block;
}
