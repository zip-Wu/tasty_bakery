<view class="container">
  <!-- 地图区域 -->
  <view class="map-wrap">
    <map
      id="storeMap"
      class="map"
      longitude="{{stores[0].longitude}}"
      latitude="{{stores[0].latitude}}"
      scale="15"
      show-location="{{true}}"
      markers="{{markers}}"
    ></map>
  </view>

  <!-- 底部选店区域 -->
  <view class="bottom-sheet">
    <view class="sheet-title">请选择门店</view>

    <view class="store-list">
      <view wx:for="{{stores}}" wx:key="id" class="store-item {{selectedStoreId === item.id ? 'active' : ''}}" bindtap="selectStore" data-id="{{item.id}}">
        <view class="store-left">
          <view class="store-name">{{item.name}}</view>
          <view class="store-addr">{{item.address}}</view>
          <view class="store-hours">营业时间：{{item.hours}}</view>
        </view>
        <view class="store-right">
          <view class="store-dist">{{item.distance}}</view>
          <view class="store-status {{item.open ? 'open' : ''}}">{{item.open ? '营业中' : '已打烊'}}</view>
        </view>
      </view>
    </view>

    <view class="confirm-btn" bindtap="confirmStore">进入点单</view>
  </view>
</view>
