<view class="container">
  <map
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    scale="17"
    markers="{{markers}}"
    show-location="{{true}}"
  ></map>

  <view class="nav-bar">
    <view class="nav-info">
      <text class="nav-name">{{name}}</text>
      <text class="nav-addr">{{address}}</text>
    </view>
    <view class="nav-btn" bindtap="goNavigate">导航到店</view>
  </view>
</view>
