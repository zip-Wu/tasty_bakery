page {
  height: 100vh;
  overflow: hidden;
}

.container {
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

.nav-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.08);
  border-radius: 24rpx 24rpx 0 0;
  box-sizing: border-box;
}

.nav-info {
  flex: 1;
  min-width: 0;
}

.nav-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.nav-addr {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-btn {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 16rpx 40rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 40rpx;
}
