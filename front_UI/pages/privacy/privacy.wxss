.privacy-page {
  padding: 40rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  background: #fff;
  min-height: 100vh;
  box-sizing: border-box;
}

.privacy-title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-align: center;
  display: block;
}

.privacy-date {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 48rpx;
  text-align: center;
  display: block;
}

.privacy-section {
  margin-bottom: 36rpx;
  display: block;
}

.privacy-label {
  font-weight: bold;
  font-size: 30rpx;
  margin-bottom: 12rpx;
  display: block;
}

.privacy-text {
  color: #555;
  margin-bottom: 8rpx;
  display: block;
  word-break: break-all;
}
