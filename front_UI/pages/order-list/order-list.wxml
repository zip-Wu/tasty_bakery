<!-- 订单列表页 -->
<view class="order-list-page tab-bar-page">
  <!-- 标签栏 -->
  <view class="tab-bar">
    <view 
      class="tab-item {{currentTab === item.key ? 'active' : ''}}" 
      wx:for="{{tabs}}" 
      wx:key="key"
      bindtap="switchTab" 
      data-tab="{{item.key}}"
    >
      {{item.name}}
      <view class="tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
  </view>

  <!-- 滑动内容区：每个 swiper-item 绑定独立数据源，避免共享数据重渲染闪屏 -->
  <swiper class="order-swiper" current="{{tabIndex}}" bindchange="onSwiperChange" duration="300">
    <swiper-item>
      <scroll-view scroll-y class="order-scroll" bindrefresherrefresh="refreshOrders" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}">
        <template is="order-list-body" data="{{orders: ordersAll}}" />
      </scroll-view>
    </swiper-item>
    <swiper-item>
      <scroll-view scroll-y class="order-scroll" bindrefresherrefresh="refreshOrders" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}">
        <template is="order-list-body" data="{{orders: ordersPending}}" />
      </scroll-view>
    </swiper-item>
    <swiper-item>
      <scroll-view scroll-y class="order-scroll" bindrefresherrefresh="refreshOrders" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}">
        <template is="order-list-body" data="{{orders: ordersPreparing}}" />
      </scroll-view>
    </swiper-item>
    <swiper-item>
      <scroll-view scroll-y class="order-scroll" bindrefresherrefresh="refreshOrders" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}">
        <template is="order-list-body" data="{{orders: ordersReady}}" />
      </scroll-view>
    </swiper-item>
    <swiper-item>
      <scroll-view scroll-y class="order-scroll" bindrefresherrefresh="refreshOrders" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}">
        <template is="order-list-body" data="{{orders: ordersCompleted}}" />
      </scroll-view>
    </swiper-item>
  </swiper>

  <!-- 自定义悬浮TabBar -->
  <custom-tab-bar></custom-tab-bar>
</view>

<!-- 订单列表模板 -->
<template name="order-list-body">
  <view class="order-list">
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0}}">
      <image class="empty-icon" src="/images/svg/clipboard.svg" mode="aspectFit"></image>
      <text class="empty-text">暂无相关订单</text>
    </view>

    <!-- 订单卡片 -->
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goOrderDetail" data-id="{{item.id}}">
      <view class="order-header">
        <view class="store-info">
          <text class="store-name">{{item.storeName}}</text>
          <text class="order-no">订单号: {{item.orderNo}}</text>
        </view>
        <view class="order-status status-{{item.status}}">
          {{item.statusText}}
          <text class="deadline-tip" wx:if="{{item.deadline}}">{{item.deadline}}</text>
        </view>
      </view>

      <!-- 取餐码 -->
      <text class="pickup-code-text" wx:if="{{(item.status === 'ready' || item.status === 'preparing') && item.pickupCode}}">取餐码：{{item.pickupCode}}</text>

      <view class="order-goods">
        <view class="goods-item" wx:for="{{item.items}}" wx:key="itemKey" wx:for-item="goods">
          <text class="goods-name">{{goods.name}}</text>
          <text class="goods-qty">x{{goods.quantity}}</text>
        </view>
        <view class="goods-more" wx:if="{{item.items.length > 3}}">
          还有 {{item.items.length - 3}} 件商品
        </view>
      </view>

      <view class="order-footer">
        <view class="order-time">{{item.timeDisplay}}</view>
        <view class="order-amount">
          <text class="amount-label">共{{item.totalQuantity}}件</text>
          <text class="amount-value">¥{{item.totalPrice}}</text>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="order-actions" catchtap="stopBubble">
        <view wx:if="{{item.status === 'pending'}}" class="action-btn primary" bindtap="goPay" data-id="{{item.id}}">
          立即支付
        </view>
        <view wx:if="{{item.status === 'preparing' || item.status === 'ready'}}" class="action-btn outline" bindtap="showProgress" data-id="{{item.id}}">
          查看进度
        </view>
        <view wx:if="{{item.status === 'completed'}}" class="action-btn outline" bindtap="reorder" data-id="{{item.id}}">
          再来一单
        </view>
      </view>
    </view>
  </view>
</template>
