page {
  background: #f5f5f5;
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.order-list-page {
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* ========== 标签栏 ========== */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #333;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #F3D624;
  border-radius: 3rpx;
}

.tab-badge {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  min-width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #fff;
  background: #ff4d4f;
  border-radius: 16rpx;
  padding: 0 8rpx;
}

/* ========== 订单滚动区 ========== */
.order-swiper {
  flex: 1;
}

.order-scroll {
  height: 100%;
}

.order-list {
  padding: 20rpx 24rpx;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* ========== 订单卡片 ========== */
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.store-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-status {
  font-size: 26rpx;
  font-weight: bold;
}

.order-status.status-pending { color: #ff6b6b; }
.order-status.status-preparing { color: #ffa502; }
.order-status.status-ready { color: #26de81; }
.order-status.status-completed { color: #999; }

.deadline-tip {
  font-size: 22rpx;
  color: #e53935;
  display: inline-block;
  font-weight: normal;
  margin-top: 4rpx;
  background: #ffebee;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
}

.pickup-code-text {
  display: block;
  font-size: 26rpx;
  color: #e53935;
  font-weight: bold;
  margin-top: 6rpx;
}

/* ========== 商品列表 ========== */
.order-goods {
  padding: 16rpx 0;
  border-top: 1rpx solid #f5f5f5;
  border-bottom: 1rpx solid #f5f5f5;
}

.goods-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.goods-name {
  font-size: 26rpx;
  color: #666;
  flex: 1;
}

.goods-temp {
  font-size: 20rpx;
  border-radius: 6rpx;
  padding: 1rpx 6rpx;
  margin-left: 6rpx;
}
.temp-cold { color: #1976d2; background: #e3f2fd; }
.temp-hot  { color: #bf360c; background: #fff3e0; }

.goods-qty {
  font-size: 26rpx;
  color: #999;
}

.goods-more {
  font-size: 24rpx;
  color: #999;
  text-align: center;
  padding: 8rpx 0;
}

/* ========== 底部信息 ========== */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-amount {
  display: flex;
  align-items: center;
}

.amount-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 8rpx;
}

.amount-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* ========== 操作按钮 ========== */
.order-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  padding: 12rpx 32rpx;
  border-radius: 40rpx;
  border: 2rpx solid #F3D624;
}

.action-btn.primary {
  background: #F3D624;
  color: #333;
}

.action-btn.outline {
  background: #fff;
  color: #8B6914;
  border-color: #F3D624;
}