<view class="custom-tab-bar">
  <view
    class="tab-item {{selected === index ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="index"
    bindtap="switchTab"
    data-index="{{index}}"
    data-path="{{item.pagePath}}"
  >
    <image class="tab-img" src="{{item.icon}}" hidden="{{selected === index}}"></image>
    <image class="tab-img tab-img-active" src="{{item.selectedIcon}}" hidden="{{selected !== index}}"></image>
  </view>
</view>