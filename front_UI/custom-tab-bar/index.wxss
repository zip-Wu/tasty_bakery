.custom-tab-bar {
  position: fixed;
  bottom: 24rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 702rpx;
  height: 110rpx;
  background: #fff;
  border-radius: 55rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.12);
  z-index: 999;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  height: 100%;
  position: relative;
}

.tab-icon {
  font-size: 40rpx;
  margin-bottom: 4rpx;
}

.tab-text {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active .tab-text {
  color: #f5a623;
  font-weight: bold;
}

.tab-item.active .tab-icon {
  transform: scale(1.1);
}
